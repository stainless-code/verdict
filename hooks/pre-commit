#!/usr/bin/env bash
# Check-only: never rewrites a file. A rewrite would reflow the prompt examples
# under skills/verdict/prompts/ (CONTRIBUTING ## Formatting).
set -euo pipefail

# git exports GIT_DIR for its hooks; the archtest and go vet child processes
# would then resolve git against this checkout instead of their own -C target.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# @latest would lint workflows against a version no one reviewed; pin it.
actionlint_pin=github.com/rhysd/actionlint/cmd/actionlint@v1.7.12

fmt_files=() shell_files=() go_files=() wf_files=() mod_files=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    skills/verdict/prompts/*) ;;
    *.md|*.mdx|*.json|*.ts) fmt_files+=("$f") ;;
    *.sh|hooks/pre-commit|hooks/pre-push) shell_files+=("$f") ;;
    *.go) go_files+=("$f") ;;
    .github/workflows/*.yml|.github/workflows/*.yaml) wf_files+=("$f") ;;
    go.mod|go.sum) mod_files+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

failed=0
fail() { printf 'pre-commit: %s\n' "$1" >&2; failed=1; }

if ((${#fmt_files[@]})); then
  if command -v bun >/dev/null 2>&1; then
    bun fmt --check -- "${fmt_files[@]}" ||
      fail "formatting issues above; run bun fmt on those files, never on prompts/ examples"
  else
    echo "pre-commit: bun not found — formatting unchecked (see CONTRIBUTING ## Formatting)"
  fi
fi

if ((${#shell_files[@]})); then
  if command -v shellcheck >/dev/null 2>&1; then
    shellcheck -S warning "${shell_files[@]}" ||
      fail "shellcheck issues above (CI gates on -S warning)"
  else
    echo "pre-commit: shellcheck not found — shell lint unchecked (CI still gates on -S warning)"
  fi
fi

if ((${#go_files[@]})); then
  if ! command -v go >/dev/null 2>&1 || ! command -v gofmt >/dev/null 2>&1; then
    fail "go and gofmt are required for staged *.go files; install Go to commit them"
  else
    unformatted="$(gofmt -l -- "${go_files[@]}")"
    if [ -n "$unformatted" ]; then
      printf '%s\n' "$unformatted"
      fail "gofmt -l lists the files above"
    fi
    pkgs=() seen=" "
    for f in "${go_files[@]}"; do
      d="${f%/*}"
      if [ "$d" = "$f" ]; then d=.; fi
      if [ "$d" != . ]; then d="./$d"; fi
      case "$seen" in *" $d "*) continue ;; esac
      seen="$seen$d "
      pkgs+=("$d")
    done
    go vet "${pkgs[@]}" || fail "go vet failed for the packages above"
    go build ./... || fail "go build ./... failed"
  fi
fi

if ((${#wf_files[@]})); then
  if command -v actionlint >/dev/null 2>&1; then
    actionlint "${wf_files[@]}" || fail "actionlint found problems in the workflows above"
  elif command -v go >/dev/null 2>&1; then
    go run "$actionlint_pin" "${wf_files[@]}" ||
      fail "actionlint found problems above, or the pinned tool could not be fetched"
  else
    echo "pre-commit: actionlint not found — workflow lint unchecked (CI still lints)"
  fi
  if command -v go >/dev/null 2>&1; then
    go test ./internal/archtest/... || fail "archtest failed (it pins the workflow structure)"
  else
    echo "pre-commit: go not found — archtest unchecked (CI still gates on it)"
  fi
fi

if ((${#mod_files[@]})); then
  if command -v go >/dev/null 2>&1; then
    go mod verify || fail "go mod verify failed (the module cache no longer matches go.sum)"
  else
    echo "pre-commit: go not found — go mod verify unchecked"
  fi
fi

exit "$failed"
