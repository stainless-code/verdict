#!/usr/bin/env bash
# The Go bar CI runs, before the push (scripts/prepush-checks.sh). Escape hatches:
# SKIP_PRE_PUSH=1 skips it. A commit that `make verify-stamp` already verified
# (stamp for every pushed sha, clean tree) skips it too; VERDICT_PREPUSH_FULL=1
# forces the full run anyway.
set -euo pipefail

# git exports GIT_DIR for its hooks; without this the tests' own `git -C <tmp>`
# calls ignore -C and inspect this checkout instead. Every command below runs
# from the worktree root, so discovery finds the repo on its own.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

if [ "${SKIP_PRE_PUSH:-0}" = 1 ]; then
  echo "pre-push: SKIP_PRE_PUSH=1 — Go gates skipped (CI still runs them)"
  exit 0
fi

if [ -t 0 ]; then
  echo "pre-push: no refs on stdin (git push supplies them); nothing to classify"
  exit 0
fi

# git hands over one line per pushed ref: local-ref local-sha remote-ref remote-sha.
refs="$(cat)"

range_paths() {
  local _local_ref local_sha _remote_ref remote_sha base
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac # all-zero sha = ref deletion
    case "$remote_sha" in
      *[!0]*) git diff --name-only "$remote_sha" "$local_sha" ;;
      *)
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
        if [ -n "$base" ]; then
          git diff --name-only "$base" "$local_sha"
        else
          git ls-tree -r --name-only "$local_sha"
        fi
        ;;
    esac
  done
}

paths="$(printf '%s\n' "$refs" | range_paths)"

full=true
if [ -n "$paths" ]; then
  full="$(printf '%s\n' "$paths" | sh scripts/ci-changes.sh)"
  full="${full#full=}"
fi

if [ "$full" != true ]; then
  echo "pre-push: pushed range is docs-only — Go gates skipped"
  exit 0
fi

# Skip the heavy suite only for commits already verified locally: every pushed
# sha carries a valid stamp and the tree is clean (scripts/verify-stamp.sh).
# The docs-only classification above is cheap and always runs first.
shas="$(printf '%s\n' "$refs" | awk '$2 !~ /^0+$/ && NF >= 2 { print $2 }' | sort -u)"
if [ "${VERDICT_PREPUSH_FULL:-0}" != 1 ] && [ -n "$shas" ]; then
  # shellcheck disable=SC2086 # one word per sha; shas are hex
  if stamped="$(sh scripts/verify-stamp.sh check $shas 2>/dev/null)"; then
    printf '%s\n' "$stamped" | while read -r sha epoch; do
      when="$(date -u -r "$epoch" '+%Y-%m-%d %H:%M:%SZ' 2>/dev/null || date -u -d "@$epoch" '+%Y-%m-%d %H:%M:%SZ' 2>/dev/null || echo "epoch $epoch")"
      echo "pre-push: $(printf %.12s "$sha") already verified by \`make verify-stamp\` at $when; skipping the full suite"
    done
    exit 0
  fi
fi

exec sh scripts/prepush-checks.sh
