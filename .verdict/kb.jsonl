{"id":"go-context-01","rule":"`ctx` is the first param; never store it in structs.","scope":"*.go","provenance":"docs/go-rules.md GO-CONTEXT-01","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
