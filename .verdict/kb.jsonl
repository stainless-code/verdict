{"id":"go-layout-02","rule":"`main` is thin: parse, `run()`, exit once; only `main` calls `os.Exit`.","scope":"*.go","provenance":"docs/go-rules.md GO-LAYOUT-02","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
