{"id":"go-errors-01","rule":"Return `error` (static type) as the last value; never concrete error types.","scope":"*.go","provenance":"docs/go-rules.md GO-ERRORS-01","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
