{"id":"go-context-03","rule":"Carry request-scoped values with unexported keys only.","scope":"*.go","provenance":"docs/go-rules.md GO-CONTEXT-03","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-context-04","rule":"Do not smuggle loggers through context.","scope":"*.go","provenance":"docs/go-rules.md GO-CONTEXT-04","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-conc-01","rule":"Every goroutine has an exit path reviewable from its spawn site.","scope":"*.go","provenance":"docs/go-rules.md GO-CONC-01","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-conc-03","rule":"Channels move ownership; mutexes guard state; maps are never shared unsynchronized.","scope":"*.go","provenance":"docs/go-rules.md GO-CONC-03","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-conc-05","rule":"`WaitGroup.Add` before `go`, same frame.","scope":"*.go","provenance":"docs/go-rules.md GO-CONC-05","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-conc-06","rule":"Set `Cmd.WaitDelay` on every command with captured pipes.","scope":"*.go","provenance":"docs/go-rules.md GO-CONC-06","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-conc-07","rule":"`go test -race -shuffle=on -count=1 ./...` is green on 3 OSes.","scope":"*.go","provenance":"docs/go-rules.md GO-CONC-07","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-iface-04","rule":"No `*io.Reader`; comma-ok every type assertion.","scope":"*.go","provenance":"docs/go-rules.md GO-IFACE-04","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-collect-02","rule":"Copy collections at trust boundaries.","scope":"*.go","provenance":"docs/go-rules.md GO-COLLECT-02","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-defer-01","rule":"`defer` cleanup at the acquisition site.","scope":"*.go","provenance":"docs/go-rules.md GO-DEFER-01","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-defer-03","rule":"Never panic for ordinary errors; `recover` only at API edges with re-panic.","scope":"*.go","provenance":"docs/go-rules.md GO-DEFER-03","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-log-01","rule":"`slog` to stderr only; stdout is machine-parseable data.","scope":"*.go","provenance":"docs/go-rules.md GO-LOG-01","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-log-03","rule":"Never `Printf` a dynamic string.","scope":"*.go","provenance":"docs/go-rules.md GO-LOG-03","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
{"id":"go-log-04","rule":"Secrets never reach logs; redact via `LogValue` + scrub helpers.","scope":"*.go","provenance":"docs/go-rules.md GO-LOG-04","rigor":"said","hits":0,"false_hits":0,"judged":0,"status":"active"}
