{
  "name": "@stainless-code/verdict",
  "version": "0.6.1",
  "description": "Code review any coding agent can run: fetch, review, gate, post. Evidence-graded findings, cost rollups, one static binary — no server, no account, no daemon.",
  "homepage": "https://stainless-code.com/verdict",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-code/verdict.git"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "cli",
    "code-review",
    "coding-agents",
    "go",
    "github",
    "llm",
    "mcp",
    "pull-request",
    "static-binary"
  ],
  "files": [
    "skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts/"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && bun fmt CHANGELOG.md",
    "release": "changeset publish",
    "prepublishOnly": "npm pack --dry-run 2>&1 | tee pack.log && (! grep -iE '\\.env|secret|token|key\\.json|\\.pem$' pack.log)"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.19.1",
    "typescript": "5.9.2"
  }
}
