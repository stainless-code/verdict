---
import { withBase } from "blume/components/islands/base-path.ts";
import { newTabAttrs } from "blume/core/new-tab.ts";
import type { Navigation, NavNode } from "blume/core/types.ts";

interface Props {
  footer?: {
    copyright?: string;
    links?: { href: string; label: string }[];
  };
  locale?: string;
  navigation: Navigation;
  site: { title: string };
}

const { footer, navigation, site } = Astro.props;

const groups = navigation.sidebar.filter(
  (node): node is Extract<NavNode, { kind: "group" }> => node.kind === "group",
);

const repoUrl = navigation.repoUrl ?? "https://github.com/stainless-code/verdict";
const linkClass =
  "text-muted-foreground transition-colors hover:text-foreground focus-visible:text-foreground";
---

<footer class="border-border border-t" data-blume-footer>
  <div class="mx-auto max-w-[1160px] px-6 py-14">
    <div class="grid gap-12 lg:grid-cols-[254px_1fr]">
      <div>
        <p
          class="flex items-center gap-2 font-display font-semibold tracking-tight"
        >
          {site.title}
        </p>
        <p
          class="mt-4 max-w-[254px] text-[14px] text-muted-foreground leading-[22px]"
        >
          Code review in steps your agent runs on your machine.
        </p>
      </div>
      <nav
        aria-label="Footer"
        class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 sm:gap-x-12"
      >
        {
          groups.map((group) => (
            <div>
              <h3 class="text-sm font-medium text-[var(--landing-faint)]">
                {group.route ? (
                  <a class={linkClass} href={withBase(group.route)}>
                    {group.label}
                  </a>
                ) : (
                  group.label
                )}
              </h3>
              <ul class="mt-3 space-y-3">
                {group.children.map((child) =>
                  child.kind === "group" ? (
                    <li>
                      <p class="text-base text-foreground">{child.label}</p>
                      <ul class="mt-2 space-y-3">
                        {child.children.map((page) =>
                          page.kind === "page" ? (
                            <li>
                              <a
                                class="inline-block -my-1 py-1 text-base text-muted-foreground transition-colors hover:text-foreground"
                                href={withBase(page.route)}
                              >
                                {page.label}
                              </a>
                            </li>
                          ) : null,
                        )}
                      </ul>
                    </li>
                  ) : (
                    <li>
                      <a
                        class="inline-block -my-1 py-1 text-base text-muted-foreground transition-colors hover:text-foreground"
                        href={withBase(child.route)}
                      >
                        {child.label}
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="mt-11 border-border border-t pt-5">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        {
          footer?.copyright && (
            <p class="text-muted-foreground">{footer.copyright}</p>
          )
        }
        {
          (footer?.links ?? []).length > 0 && (
            <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
              {(footer?.links ?? []).map((link) => (
                <li>
                  <a
                    class={linkClass}
                    href={withBase(link.href)}
                    {...newTabAttrs(link.href)}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <a
          aria-label="GitHub repository"
          class="ms-auto inline-flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
          href={repoUrl}
          {...newTabAttrs(repoUrl)}
        >
          <svg
            aria-hidden="true"
            fill="currentColor"
            height="18"
            viewBox="0 0 24 24"
            width="18"
          >
            <path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
