---
import data from "blume:data";
import { contentHref } from "blume/components/content/base-href.ts";
import Logo from "blume/components/layout/Logo.astro";
import { footerColumns } from "../navigation.ts";

interface Props {
  route?: string;
  page?: unknown;
  headings?: unknown;
  footer?: unknown;
  locale?: string;
  site?: unknown;
  navigation?: unknown;
  ui?: unknown;
}

const { config } = data;
const year = new Date().getFullYear();
// The site-wide Footer slot passes no route, so the component reads the URL
// itself: strip the deployment base and render only on the three content
// landings. The home page imports this file directly; its URL ("/" or the
// base) is in the same set. An explicit route prop, when given, wins.
const LANDING_ROUTES = new Set(["/", "/agents", "/compare", "/roadmap"]);
const raw = Astro.url.pathname.replace(/\/+$/u, "") || "/";
const base = "/verdict";
const fromUrl =
  raw === base ? "/" : raw.startsWith(`${base}/`) ? raw.slice(base.length) : raw;
const propRoute = (Astro.props as Props).route;
const show =
  propRoute === undefined ? LANDING_ROUTES.has(fromUrl) : LANDING_ROUTES.has(propRoute);
---

{show && (
  <>
  <style>
    /* Column count comes from the data, not a fixed grid: one row of link
       columns on desktop for any group count, 3 per row at tablet, 2 per
       row on phones. Links never wrap (whitespace-nowrap above), so columns
       size to their longest link. */
    .sitemap-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    @media (min-width: 48rem) {
      .sitemap-nav {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    @media (min-width: 64rem) {
      .sitemap-nav {
        grid-template-columns: repeat(var(--footer-cols), auto);
        justify-content: space-between;
      }
    }
  </style>
  <footer class="border-border border-t">
    <div class="mx-auto max-w-[1160px] px-6 py-14">
      <div class="grid gap-12 lg:grid-cols-[254px_1fr]">
        <div>
          <Logo logo={data.config.logo} site={{ title: config.title }} />
          <p class="mt-4 max-w-[254px] text-[14px] text-muted-foreground leading-[22px]">
            Code review in steps your agent runs on your machine. It fetches a
            pull request, a branch, a commit range or staged changes, and grades every
            finding by how it was checked.
          </p>
        </div>
        <nav aria-label="Footer" class="sitemap-nav grid gap-x-8 gap-y-10" style={`--footer-cols: ${footerColumns.length};`}>
          {footerColumns.map((column) => (
            <div class="min-w-0">
              <h3 class="whitespace-nowrap text-sm font-medium text-[var(--landing-faint)]">{column.label}</h3>
              <ul class="mt-3 space-y-3">
                {column.links.map((link) => (
                  <li>
                    <a href={contentHref(link.path)} class="inline-block -my-1 whitespace-nowrap py-1 text-sm text-muted-foreground transition-colors hover:text-foreground">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      <div class="mt-11 border-border border-t pt-5">
        <div class="mx-auto flex flex-col items-center justify-between gap-2 text-xs text-[var(--landing-faint)] sm:flex-row">
          <span>© {year} stainless-code, <a href="https://github.com/stainless-code/verdict/blob/main/LICENSE" rel="noreferrer" target="_blank" class="inline-block py-1.5 transition-colors hover:text-foreground">MIT licensed</a></span>
          <span>Built and maintained by <a href="https://stainless-code.com" rel="noreferrer" target="_blank" class="inline-block py-1.5 transition-colors hover:text-foreground">stainless-code</a></span>
        </div>
      </div>
    </div>
  </footer>
  </>
)}
