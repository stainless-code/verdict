---
interface Props {
  /** `brand`: the fixed red stamp (header, footer, favicon — identical in
      both modes). `paper`: white plate for the accent band. */
  tone?: "brand" | "paper";
  size?: number;
}

const { tone = "brand", size = 26 } = Astro.props;
const square = tone === "brand" ? "var(--landing-brand)" : "var(--landing-paper)";
const glyph = tone === "brand" ? "var(--landing-brand-ink)" : "var(--landing-band)";
---

<svg
  aria-hidden="true"
  class="block"
  fill="none"
  viewBox="0 0 32 32"
  style={`width: ${size}px; height: ${size}px;`}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="32" height="32" rx="8" style={`fill: ${square}`} />
  <path
    d="M9 10.5 16 22 23 10.5"
    style={`stroke: ${glyph}`}
    stroke-width="3.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M11 25.5h10"
    style={`stroke: ${glyph}`}
    stroke-width="2.4"
    stroke-linecap="round"
    opacity="0.65"
  />
</svg>
