---
import { contentHref } from "blume/components/content/base-href.ts";
---

<section class="border-border border-y">
  <p class="mx-auto max-w-3xl px-6 py-16 text-center text-balance font-display font-medium text-2xl leading-snug tracking-tight sm:py-20 sm:text-[34px] sm:leading-[1.2]">
    The whole review: <a href={contentHref("/how-it-reviews")} class="underline decoration-border decoration-1 underline-offset-8 hover:decoration-accent">ten verbs, eight prompts, three dependencies</a>, one posted review.
  </p>
  <p class="mx-auto max-w-3xl px-6 pb-16 text-center text-balance text-base text-muted-foreground sm:pb-20">
    The review tool for people who don't trust review tools.
  </p>
</section>
