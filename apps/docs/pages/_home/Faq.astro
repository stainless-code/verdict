---
import SectionHead from "./SectionHead.astro";
import Inline from "./Inline.astro";
import { faq } from "./faq.ts";
---

<section id="faq" class="mx-auto max-w-[1160px] scroll-mt-20 px-6 py-16 sm:py-24">
  <SectionHead title="Questions people ask." align="start" />
  <div class="mt-10 max-w-[70ch] border-border border-t">
    {
      faq.map((item) => (
        <details class="faq group border-border border-b">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display font-semibold text-lg tracking-tight">
            <span>{item.q}</span>
            <span aria-hidden="true" class="faq-mark shrink-0 font-mono text-xl text-accent"></span>
          </summary>
          <div class="space-y-3 pb-6 text-base text-muted-foreground leading-relaxed">
            {item.a.map((paragraph) => (
              <p><Inline text={paragraph} /></p>
            ))}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-mark::before {
    content: "+";
  }
  .faq[open] .faq-mark::before {
    content: "\2212";
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--blume-accent);
    outline-offset: 2px;
    border-radius: 0.375rem;
  }
</style>
