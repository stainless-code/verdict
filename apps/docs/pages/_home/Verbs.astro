---
const rows = [
  {
    verb: "fetch",
    command: "verdict fetch owner/repo 123",
    body: "Writes the diff, metadata, threads and file roles to .review/123/. On GitHub it needs no clone.",
  },
  {
    verb: "review",
    command: "your agent + the verdict skill",
    body: "The agent reads the whole diff first. It asks read-only lens subagents a falsifiable question only when the answer could change the verdict. It writes one review.json.",
  },
  {
    verb: "post",
    command: "verdict post owner/repo 123",
    body: "Checks every anchor against the diff hunks, turns suggestions into GitHub suggestion blocks, and submits one review.",
  },
  {
    verb: "no PR?",
    command: "verdict fetch-local owner/repo work",
    body: "Bundles your local changes the same way. Review them, then run verdict record owner/repo local-work. Nothing is posted.",
  },
];
---

<section id="verbs" class="mx-auto max-w-[1160px] scroll-mt-20 px-6 py-16 sm:py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-balance font-display font-semibold text-[32px] leading-[1.05] tracking-tight sm:text-[52px] sm:leading-[1.02]">
      Fetch, review, post.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-balance text-lg text-muted-foreground">
      The verbs below are the whole first review. Other verbs read the store,
      triage findings and gate CI.
    </p>
  </div>
  <ol class="mt-12 border-border border-t">
    {
      rows.map((row) => (
        <li class="grid gap-2 border-border border-b py-8 sm:grid-cols-[220px_1fr] sm:gap-8">
          <span class="font-display font-semibold text-2xl tracking-tight">{row.verb}</span>
          <div>
            <code class="font-mono text-sm text-accent">{row.command}</code>
            <p class="mt-2 max-w-[65ch] text-muted-foreground">{row.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
