---
import { contentHref } from "blume/components/content/base-href.ts";
import Icon from "blume/components/Icon.astro";
import InstallSwitcher from "../../components/InstallSwitcher.astro";
import CopyCommand from "./CopyCommand.astro";

// The names `verdict skill install --agent` accepts (see `verdict skill --help`).
const agents = ["claude", "cursor", "codex", "opencode", "copilot", "gemini", "goose", "qwen", "windsurf", "agents"];
---

<section class="mx-auto max-w-[1160px] px-6 pt-16 pb-16 sm:pt-24 sm:pb-20">
  <div class="mx-auto max-w-3xl text-center">
    <h1
      class="mx-auto mt-5 max-w-3xl text-balance font-display font-semibold text-5xl leading-[1.02] tracking-tight sm:text-6xl"
    >
      <span class="block">PR reviews</span>
      <span class="block text-accent">with receipts.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-balance text-lg text-muted-foreground">
      Verdict fetches the PR, your agent reviews it, and exactly one review posts.
      One static binary, no server, no account.
    </p>

    <div class="mx-auto mt-10 w-full max-w-[40rem] space-y-8 text-left">
      <div>
        <h2 class="mb-3 font-display font-semibold text-base tracking-tight">
          <span class="text-accent">1.</span> Install
        </h2>
        <InstallSwitcher />
      </div>

      <div>
        <h2 class="mb-3 font-display font-semibold text-base tracking-tight">
          <span class="text-accent">2.</span> Add the skill
        </h2>
        <div class="flex w-full max-w-full min-w-0">
          <CopyCommand command="verdict skill install --detect" />
        </div>
        <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
          Installs into every agent that already has a skills directory. Target one with{" "}
          <code class="font-mono text-foreground">--agent &lt;name&gt;</code>, where the name is{" "}
          {
            agents.map((agent, i) => (
              <>
                <code class="font-mono text-foreground">{agent}</code>
                {i < agents.length - 1 ? ", " : ""}
              </>
            ))
          }. Prefer the registry? Run{" "}
          <code class="font-mono text-foreground">npx skills add stainless-code/verdict</code>.
        </p>
      </div>

      <div>
        <h2 class="mb-3 font-display font-semibold text-base tracking-tight">
          <span class="text-accent">3.</span> Review a PR
        </h2>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Run <code class="font-mono text-foreground">verdict fetch owner/repo 123</code>, ask your
          agent to review <code class="font-mono text-foreground">.review/123/</code>, then run{" "}
          <code class="font-mono text-foreground">verdict post owner/repo 123</code>. For local
          changes, use <code class="font-mono text-foreground">verdict fetch-local</code>.
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        class="inline-flex h-11 items-center gap-2 whitespace-nowrap rounded-[9px] bg-accent px-5 font-medium text-base text-[var(--blume-accent-foreground)] transition-opacity hover:opacity-90"
        href={contentHref("/quickstart")}
      >
        Quickstart
        <Icon name="arrow-right" size={14} />
      </a>
      <a
        class="inline-flex h-11 items-center gap-2 whitespace-nowrap rounded-[9px] border border-border px-5 font-medium text-base text-foreground transition-colors hover:border-foreground"
        href="#verbs"
      >
        How it works
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>
