---
import { contentHref } from "blume/components/content/base-href.ts";
import InstallSwitcher from "../../components/InstallSwitcher.astro";

/**
 * The hero carries the one install surface: every route (npm, pnpm, bun,
 * yarn, Homebrew, script, PowerShell) lives here and nowhere else on the
 * page. The closing band mirrors the selected route instead of mounting a
 * second copy of the tab strip.
 *
 * The sentence under the headline is the same first sentence as README.md and
 * the site description, so all three open with one claim.
 */
---

<section class="mx-auto max-w-[1160px] px-6 pt-16 pb-14 sm:pt-24 sm:pb-20">
  <div class="mx-auto max-w-3xl text-center">
    <h1
      class="mx-auto max-w-3xl text-balance font-display font-semibold text-5xl leading-[1.02] tracking-tight sm:text-7xl"
    >
      <span class="block">Code review</span>
      <span class="block text-accent">with receipts.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-balance text-lg text-muted-foreground">
      Verdict runs code review on your machine, with your agent as reviewer.
    </p>

    <div id="install" class="mx-auto mt-10 w-full max-w-[44rem] scroll-mt-24">
      <InstallSwitcher name="hero" />
    </div>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        class="inline-flex h-11 items-center whitespace-nowrap rounded-[9px] bg-foreground px-5 font-medium text-background text-base transition-opacity hover:opacity-90"
        href={contentHref("/quickstart")}
      >
        Read the quickstart
      </a>
      <a
        class="inline-flex h-11 items-center whitespace-nowrap rounded-[9px] border border-border px-5 font-medium text-base text-foreground transition-colors hover:bg-muted"
        href={contentHref("/how-it-reviews")}
      >
        See how it reviews
      </a>
    </div>
  </div>
</section>
