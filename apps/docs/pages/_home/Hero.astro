---
import { contentHref } from "blume/components/content/base-href.ts";
import Icon from "blume/components/Icon.astro";
import InstallSwitcher from "../../components/InstallSwitcher.astro";
---

<section class="mx-auto max-w-[1160px] px-6 pt-16 pb-14 sm:pt-24 sm:pb-20">
  <div class="mx-auto max-w-3xl text-center">
    <h1
      class="mx-auto max-w-3xl text-balance font-display font-semibold text-5xl leading-[1.02] tracking-tight sm:text-7xl"
    >
      <span class="block">PR reviews</span>
      <span class="block text-accent">with receipts.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-balance text-lg text-muted-foreground">
      Verdict fetches the PR, your agent reviews it, and exactly one review posts.
      One static binary. No server, no account.
    </p>

    <div id="install" class="mx-auto mt-10 w-full max-w-[44rem] scroll-mt-24">
      <InstallSwitcher name="hero" />
    </div>

    <p class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
      <a
        class="relative inline-flex items-center gap-1.5 text-muted-foreground underline decoration-border underline-offset-4 transition-colors after:absolute after:-inset-3 after:content-[''] hover:text-foreground hover:decoration-accent"
        href="#how-it-works"
      >
        How it works
        <Icon name="arrow-down" size={14} />
      </a>
      <a
        class="relative inline-flex items-center gap-1.5 text-muted-foreground underline decoration-border underline-offset-4 transition-colors after:absolute after:-inset-3 after:content-[''] hover:text-foreground hover:decoration-accent"
        href={contentHref("/quickstart")}
      >
        Quickstart
        <Icon name="arrow-right" size={14} />
      </a>
    </p>
  </div>
</section>
