---
/**
 * A terminal frame around output the binary actually printed. Lines hold
 * plain text, so the block reads the same without colour, and they wrap
 * instead of scrolling sideways. An elided stretch is a `gap` line, which
 * renders as `⋯`; nothing else in here is edited.
 *
 * The run behind the homepage sample is recorded in `docs/landing-claims.md`.
 */
interface Line {
  kind: "cmd" | "out" | "dim" | "fail" | "gap";
  text?: string;
}

interface Props {
  title: string;
  lines: Line[];
  caption?: string;
}

const { title, lines, caption } = Astro.props;

const tone: Record<Line["kind"], string> = {
  cmd: "text-foreground",
  out: "text-muted-foreground",
  dim: "text-[var(--landing-faint)]",
  fail: "font-medium text-accent",
  gap: "text-[var(--landing-faint)]",
};
---

<figure class="m-0">
  <div class="overflow-hidden rounded-2xl border border-border bg-[var(--landing-surface)]">
    <div class="border-border border-b bg-muted px-5 py-3">
      <figcaption class="font-mono text-xs text-muted-foreground">{title}</figcaption>
    </div>
    <pre
      class="m-0 px-5 py-5 font-mono text-[12.5px] leading-[1.75] sm:text-[13px]"
      tabindex="0"
      aria-label={title}
    ><code>{lines.map((line) => <span class={`term-line block ${tone[line.kind]}`}>{line.kind === "cmd" && <span aria-hidden="true" class="prompt">$ </span>}{line.kind === "gap" && <span class="sr-only">Progress lines elided: </span>}{line.kind === "gap" ? "⋯" : line.text}</span>)}</code></pre>
  </div>
  {caption && <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{caption}</p>}
</figure>

<style>
  /* Reset the docs prose styling on <pre>/<code>; one span per line. */
  .term-line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .prompt {
    color: var(--landing-faint);
    user-select: none;
  }

  pre code {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    white-space: inherit;
  }
</style>
