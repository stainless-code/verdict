---
import Icon from "blume/components/Icon.astro";

/**
 * One command in a box with a copy button. The command wraps instead of
 * truncating, so a narrow screen never hides part of it.
 *
 * Sources: the same commands as the install switcher and docs/manual.md.
 */
interface Props {
  command: string;
  /** Stretch to the width of the parent instead of the command's own width. */
  fill?: boolean;
}

const { command, fill = false } = Astro.props;
---

<div
  class={`flex ${fill ? "w-full" : "w-fit"} max-w-full min-w-0 items-center gap-3 rounded-xl border border-border bg-[var(--landing-surface)] py-2.5 pr-2.5 pl-4`}
>
  <span aria-hidden="true" class="select-none font-mono text-base text-[var(--landing-faint)]">$</span>
  <code class="min-w-0 flex-1 font-mono text-[13px] text-foreground leading-[1.5] break-words whitespace-pre-wrap sm:text-base">{command}</code>
  <button
    aria-label={`Copy: ${command}`}
    class="relative inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-lg bg-muted text-muted-foreground transition-colors after:absolute after:-inset-1.5 after:content-[''] hover:text-foreground"
    data-copy-command
    data-command={command}
    type="button"
  >
    <span data-copy-idle><Icon name="copy" size={15} /></span>
    <span data-copy-done hidden><Icon name="check" size={15} /></span>
  </button>
  <span aria-live="polite" class="sr-only" data-copy-status></span>
</div>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const button = target?.closest("[data-copy-command]");
    if (!(button instanceof HTMLElement)) return;
    const command = button.dataset.command ?? "";
    try {
      await navigator.clipboard.writeText(command);
    } catch {
      // No clipboard access: say nothing rather than claim success.
      return;
    }
    const idle = button.querySelector<HTMLElement>("[data-copy-idle]");
    const done = button.querySelector<HTMLElement>("[data-copy-done]");
    const status = button
      .closest("div")
      ?.querySelector<HTMLElement>("[data-copy-status]");
    if (idle) idle.hidden = true;
    if (done) done.hidden = false;
    if (status) status.textContent = "Copied to clipboard";
    setTimeout(() => {
      if (idle) idle.hidden = false;
      if (done) done.hidden = true;
      if (status) status.textContent = "";
    }, 1500);
  });
</script>
