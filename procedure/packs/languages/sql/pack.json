{
  "schema_version": "1",
  "name": "verdict/sql",
  "version": "1.0.0",
  "severity": {
    "critical": "critical",
    "important": "important"
  },
  "lenses": [
    {
      "id": "sql",
      "globs": ["**/*.sql"],
      "max_files": 12
    }
  ],
  "rules": [
    {
      "id": "sql-destructive-ddl",
      "severity": "critical",
      "globs": ["**/*.sql"]
    },
    {
      "id": "sql-lock-heavy-migration",
      "severity": "critical",
      "globs": ["**/*.sql"]
    },
    {
      "id": "sql-dynamic-string",
      "severity": "important",
      "globs": ["**/*.sql"]
    }
  ]
}
