{
  "schema_version": "1",
  "name": "verdict/github-workflows",
  "version": "1.1.0",
  "severity": {
    "critical": "critical",
    "important": "important"
  },
  "lenses": [
    {
      "id": "github-workflows",
      "globs": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
      "max_files": 12
    }
  ],
  "rules": [
    {
      "id": "gha-code-exec-from-pr",
      "severity": "critical",
      "globs": [".github/workflows/*.yml", ".github/workflows/*.yaml"]
    },
    {
      "id": "gha-script-injection",
      "severity": "critical",
      "globs": [".github/workflows/*.yml", ".github/workflows/*.yaml"]
    },
    {
      "id": "gha-unpinned-action",
      "severity": "important",
      "globs": [".github/workflows/*.yml", ".github/workflows/*.yaml"]
    },
    {
      "id": "gha-permissions",
      "severity": "important",
      "globs": [".github/workflows/*.yml", ".github/workflows/*.yaml"]
    }
  ]
}
