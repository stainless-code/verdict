{
  "schema_version": "1",
  "name": "verdict/shell",
  "version": "1.1.0",
  "severity": {
    "critical": "critical",
    "important": "important"
  },
  "lenses": [
    {
      "id": "shell",
      "globs": ["**/*.sh", "**/*.bash"],
      "max_files": 12
    }
  ],
  "rules": [
    {
      "id": "sh-unquoted-expansion",
      "severity": "critical",
      "globs": ["**/*.sh", "**/*.bash"]
    },
    {
      "id": "sh-pipe-masking",
      "severity": "critical",
      "globs": ["**/*.sh", "**/*.bash"]
    },
    {
      "id": "sh-destructive-path",
      "severity": "critical",
      "globs": ["**/*.sh", "**/*.bash"]
    },
    {
      "id": "sh-eval-untrusted",
      "severity": "critical",
      "globs": ["**/*.sh", "**/*.bash"]
    },
    {
      "id": "sh-tmp-mktemp",
      "severity": "important",
      "globs": ["**/*.sh", "**/*.bash"]
    }
  ]
}
