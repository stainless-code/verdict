 #!/usr/bin/env bash
-set -e
+set -euo pipefail
+target=${1:?target is required}
+cd "$target" || exit 1
+staging="$(mktemp -d)"
+trap 'rm -rf -- "$staging"' EXIT
+if ! build | tee "$staging/build.log"; then
+  printf 'build failed\n' >&2
+  exit 1
+fi
+rm -rf -- "${staging:?}"/*
