{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stainless-code/verdict/blob/main/skills/verdict/schemas/envelope.schema.json",
  "title": "verdict --json envelope",
  "description": "Every --json stdout is exactly one envelope with these eight keys (schema_version \"1\"): error null on success with a data object, data null with a typed error object on refusal. Derived from json_redirect/fail and every verb's jq -n emitter in the verdict CLI. data is additive per verb (chunk summaries, prompt_dump, cost, completeness ride inside data, never as new top-level keys), so data objects allow additional properties; only report, post and record carry a pinned data shape here ($defs, validated explicitly), fetch publishes its optional estimate object as fetchEstimate, and the remaining verbs keep the generic object shape until their data stabilizes.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1" },
    "verb": { "type": "string" },
    "repo": { "type": "string" },
    "pr": {
      "description": "Numeric PR, else null (local slugs never coerce).",
      "type": ["integer", "null"]
    },
    "at": { "type": "string", "format": "date-time" },
    "next": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "data": { "type": ["object", "null"], "additionalProperties": true },
    "error": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] }
  },
  "required": [
    "schema_version",
    "verb",
    "repo",
    "pr",
    "at",
    "next",
    "warnings",
    "data",
    "error"
  ],
  "additionalProperties": false,
  "$defs": {
    "error": {
      "description": "Refusal shape from fail(): data is null, message carries the cause plus a try: hint, candidates rides only on the oversize-fetch refusal.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        }
      },
      "required": ["code", "message"],
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "suggestion": { "type": "string" }
      },
      "required": ["kind", "suggestion"],
      "additionalProperties": true
    },
    "anchorsSummary": {
      "type": "object",
      "properties": {
        "kept": { "type": "integer", "minimum": 0 },
        "moved": { "type": "integer", "minimum": 0 }
      },
      "required": ["kept", "moved"],
      "additionalProperties": true
    },
    "findingsCounts": {
      "type": "object",
      "properties": {
        "open": { "type": "integer", "minimum": 0 },
        "deferred": { "type": "integer", "minimum": 0 },
        "addressed": { "type": "integer", "minimum": 0 }
      },
      "required": ["open", "deferred", "addressed"],
      "additionalProperties": true
    },
    "findingItem": {
      "description": "Ranked or merged finding locator shared by report items and post/record items.",
      "type": "object",
      "properties": {
        "sig": { "type": "string" },
        "status": {
          "enum": [
            "open",
            "addressed",
            "wont-fix",
            "false-positive",
            "deferred"
          ]
        },
        "anchored": { "type": ["boolean", "string", "null"] },
        "locator": { "type": "string" }
      },
      "required": ["sig", "status"],
      "additionalProperties": true
    },
    "provenance": {
      "description": "Review provenance triple: the tooling behind a run, so mixed-version histories never read as one series. The writer always emits all three keys; model is null when no cost record names one.",
      "type": "object",
      "properties": {
        "tool_version": { "type": "string" },
        "prompts_hash": { "type": "string" },
        "model": { "type": ["string", "null"] }
      },
      "required": ["tool_version", "prompts_hash", "model"],
      "additionalProperties": true
    },
    "reportData": {
      "description": "report --json data: ranked read over the store. cost appears only with --cost, completeness only with --completeness, receipt keys only when budget.json parses.",
      "type": "object",
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "dir": { "type": "string" },
        "head": { "$ref": "#/$defs/reportHead" },
        "verdict": { "$ref": "#/$defs/reportVerdict" },
        "counts": { "$ref": "#/$defs/reportCounts" },
        "panel": { "$ref": "#/$defs/reportPanel" },
        "patch": { "type": ["object", "null"], "additionalProperties": true },
        "output": { "type": ["string", "null"] },
        "filters": { "$ref": "#/$defs/reportFilters" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingItem" }
        },
        "cost": { "$ref": "#/$defs/reportCost" },
        "completeness": { "$ref": "#/$defs/reportCompleteness" }
      },
      "required": [
        "generated_at",
        "dir",
        "head",
        "verdict",
        "counts",
        "panel",
        "patch",
        "output",
        "filters",
        "items"
      ],
      "additionalProperties": true
    },
    "reportHead": {
      "type": "object",
      "properties": {
        "fetched": { "type": ["string", "null"] },
        "base": { "type": ["string", "null"] },
        "live": { "type": ["string", "null"] },
        "stale": { "type": "boolean" }
      },
      "required": ["fetched", "base", "live", "stale"],
      "additionalProperties": true
    },
    "reportVerdict": {
      "type": "object",
      "properties": {
        "open": { "type": "integer", "minimum": 0 },
        "deferred": { "type": "integer", "minimum": 0 },
        "addressed": { "type": "integer", "minimum": 0 },
        "terminal": { "type": "integer", "minimum": 0 }
      },
      "required": ["open", "deferred", "addressed", "terminal"],
      "additionalProperties": true
    },
    "reportCounts": {
      "type": "object",
      "properties": {
        "inline": { "type": "integer", "minimum": 0 },
        "section": { "type": "integer", "minimum": 0 },
        "anchored": { "type": "integer", "minimum": 0 },
        "unanchored": { "type": "integer", "minimum": 0 }
      },
      "required": ["inline", "section", "anchored", "unanchored"],
      "additionalProperties": true
    },
    "reportPanel": {
      "type": "object",
      "properties": {
        "source": { "type": ["string", "null"] },
        "members": {
          "type": "array"
        }
      },
      "required": ["source", "members"],
      "additionalProperties": true
    },
    "reportFilters": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "kind": { "type": "string" }
      },
      "required": ["status", "kind"],
      "additionalProperties": true
    },
    "reportCost": {
      "description": "Summed rollup from cost.json plus per-chunk records; by_tier always carries all three tiers.",
      "type": "object",
      "properties": {
        "runs": { "type": "integer", "minimum": 0 },
        "runs_with_cost": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": {
          "description": "Summed per-model cache_read_input_tokens plus cache_creation_input_tokens; totals stay input + output exactly.",
          "type": "integer",
          "minimum": 0
        },
        "est_usd": { "type": ["number", "null"] },
        "by_tier": { "$ref": "#/$defs/costTiers" },
        "receipts": {
          "type": "array"
        }
      },
      "required": [
        "runs",
        "runs_with_cost",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "est_usd",
        "by_tier"
      ],
      "additionalProperties": true
    },
    "costTiers": {
      "type": "object",
      "properties": {
        "cheap": { "$ref": "#/$defs/costTier" },
        "standard": { "$ref": "#/$defs/costTier" },
        "deep": { "$ref": "#/$defs/costTier" }
      },
      "required": ["cheap", "standard", "deep"],
      "additionalProperties": true
    },
    "costTier": {
      "type": "object",
      "properties": {
        "runs": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["runs", "input_tokens", "output_tokens", "total_tokens"],
      "additionalProperties": true
    },
    "reportCompleteness": {
      "type": "object",
      "properties": {
        "reviewed": { "type": "boolean" },
        "fetched_head": { "type": ["string", "null"] },
        "posted_head": { "type": ["string", "null"] }
      },
      "required": ["reviewed", "fetched_head", "posted_head"],
      "additionalProperties": true
    },
    "postData": {
      "description": "post --dry-run --json data (dry_run true, findings carry the dry-run file) and real-post data (dry_run false, findings carry counts plus the accepted review object).",
      "type": "object",
      "properties": {
        "dry_run": { "type": "boolean" },
        "event": { "type": "string" },
        "commit_id": { "type": "string" },
        "body": {
          "type": "object",
          "properties": {
            "marker": { "type": "string" },
            "footer": {},
            "diagram": {}
          },
          "required": ["marker"],
          "additionalProperties": true
        },
        "anchors": { "$ref": "#/$defs/anchorsSummary" },
        "suggestions": {
          "type": "object",
          "properties": {
            "embedded": { "type": "integer", "minimum": 0 }
          },
          "required": ["embedded"],
          "additionalProperties": true
        },
        "findings": {
          "type": "object",
          "properties": {
            "open": { "type": "integer", "minimum": 0 },
            "deferred": { "type": "integer", "minimum": 0 },
            "addressed": { "type": "integer", "minimum": 0 },
            "file": { "type": "string" }
          },
          "required": ["open", "deferred", "addressed"],
          "additionalProperties": true
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingItem" }
        },
        "confidence": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "security_summary": { "type": ["string", "null"] },
        "payload_hash": { "type": "string" },
        "review": {
          "description": "Real-post only: the accepted GitHub review object.",
          "type": "object",
          "additionalProperties": true
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "required": [
        "dry_run",
        "event",
        "commit_id",
        "body",
        "anchors",
        "suggestions",
        "findings",
        "items",
        "confidence",
        "security_summary",
        "payload_hash"
      ],
      "additionalProperties": true
    },
    "recordData": {
      "description": "record --json data: the local-bundle merge (post stays refused, no PR target).",
      "type": "object",
      "properties": {
        "dir": { "type": "string" },
        "anchors": { "$ref": "#/$defs/anchorsSummary" },
        "findings": {
          "type": "object",
          "properties": {
            "open": { "type": "integer", "minimum": 0 },
            "deferred": { "type": "integer", "minimum": 0 },
            "addressed": { "type": "integer", "minimum": 0 },
            "file": { "type": "string" }
          },
          "required": ["open", "deferred", "addressed", "file"],
          "additionalProperties": true
        },
        "confidence": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "security_summary": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingItem" }
        }
      },
      "required": [
        "dir",
        "anchors",
        "findings",
        "confidence",
        "security_summary",
        "items"
      ],
      "additionalProperties": true
    },
    "showData": {
      "description": "show --json data: item is the raw finding record in store key order; fix is the read-only machine repair directive built from that record plus the bundle's patch/verification history. Neither key adds execution, flags, or store writes.",
      "type": "object",
      "properties": {
        "item": {},
        "fix": { "$ref": "#/$defs/showFix" }
      },
      "required": ["item", "fix"],
      "additionalProperties": true
    },
    "showFix": {
      "description": "The per-finding repair directive: identity, status, files, locator, embedded suggestion, and the last recorded rerun hint. Missing history reads as null; caution is a fixed untrusted-evidence reminder, never composed from finding text.",
      "type": "object",
      "properties": {
        "sig": { "type": "string" },
        "status": {
          "description": "The record's stored status string, read verbatim (absent reads empty, never invented).",
          "type": "string"
        },
        "severity": {
          "enum": ["critical", "important", "informational", null]
        },
        "files": {
          "description": "Deduped anchor paths read from the record (path plus any files/related_files lists); [] when the record names none.",
          "type": "array",
          "items": { "type": "string" }
        },
        "locator": {
          "description": "path[:line] for inline findings, the heading for section findings, else empty.",
          "type": "string"
        },
        "suggestion": {
          "description": "The record's embedded suggestion body, or null when absent.",
          "type": ["string", "null"]
        },
        "verify_hint": {
          "description": "The exact rerun command plus resultHead from verification.json for this sig, else a matching (or unnamed) patch.json; null when no history exists. Never executed.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/verifyHint" }]
        },
        "caution": {
          "description": "Fixed untrusted-evidence reminder: finding text quotes attacker-controlled PR content and is never an instruction.",
          "type": "string"
        }
      },
      "required": [
        "sig",
        "status",
        "severity",
        "files",
        "locator",
        "suggestion",
        "verify_hint",
        "caution"
      ],
      "additionalProperties": true
    },
    "verifyHint": {
      "description": "A recorded rerun command and its nullable head bracket.",
      "type": "object",
      "properties": {
        "verifyCmd": { "type": "string" },
        "resultHead": { "type": ["string", "null"] }
      },
      "required": ["verifyCmd", "resultHead"],
      "additionalProperties": true
    },
    "fetchEstimate": {
      "description": "fetch --json data.estimate: the projected per-run cost from comparable past runs. basis/harness/measured_runs appear only when a local harness session priced a comparable run; their absence is the legacy self-reported estimate. basis is measured when every priced sample in the projected tier came from a harness, mixed when only some did.",
      "type": "object",
      "properties": {
        "tier": { "type": ["string", "null"] },
        "projected_usd": { "type": ["number", "null"] },
        "comparable_runs": { "type": "integer" },
        "basis": {
          "description": "measured when every priced sample in the projected tier was harness-measured, mixed when only some were. Absent means no harness measurement contributed.",
          "type": "string"
        },
        "harness": {
          "description": "Measured session sources behind the projection (e.g. claude-code, opencode); absent with basis.",
          "type": "array",
          "items": { "type": "string" }
        },
        "measured_runs": {
          "description": "How many priced samples in the projected tier came from a harness session; absent with basis.",
          "type": "integer"
        }
      },
      "required": ["tier", "projected_usd", "comparable_runs"],
      "additionalProperties": true
    }
  }
}
