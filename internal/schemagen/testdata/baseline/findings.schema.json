{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stainless-code/verdict/blob/main/skills/verdict/schemas/findings.schema.json",
  "title": "findings.json — merged findings store",
  "description": "What post/record write per bundle. Derived from validate_and_merge in the verdict CLI: stable line-number-free sigs, append-only history, re-post merges that keep prior fields ($prev + new, so unknown keys pass through — this schema allows them). rigor is always normalized to the enum, severity and category to the enum-or-null (unknown category values warn and read null), kb defaults to []. Section entries carry anchored:\"body\" instead of a boolean.",
  "type": "array",
  "items": { "$ref": "#/$defs/entry" },
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "sig": {
          "description": "Stable cross-run join key: SHA-1 of path + heading + body, whitespace-squashed.",
          "type": "string"
        },
        "sig_version": {
          "description": "Normalization generation; backfilled onto older entries, never clobbered.",
          "const": "1"
        },
        "kind": { "enum": ["inline", "section"] },
        "path": {
          "description": "Inline findings only.",
          "type": ["string", "null"]
        },
        "heading": {
          "description": "Section findings only: the exact ### body heading.",
          "type": ["string", "null"]
        },
        "line": { "type": ["integer", "null"] },
        "side": { "type": ["string", "null"] },
        "anchored": {
          "description": "Inline: true when the anchor sits inside one reviewed hunk. Section: the string \"body\".",
          "type": ["boolean", "string", "null"]
        },
        "body": { "type": "string" },
        "suggestion": { "type": ["string", "null"] },
        "brief": {
          "description": "Optional machine brief; excluded from the sig, and preserved across re-record when the fresh comment carries none.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/brief" }]
        },
        "sources": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "kb": {
          "description": "Cited knowledge-base rule ids; [] when uncited.",
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "inBounds": {
          "description": "CamelCase in the store (hyphenated in review.json input); absent reads true.",
          "type": ["boolean", "null"]
        },
        "rigor": {
          "description": "Evidence rung on inline findings; the re-post merge stamps an explicit null onto section entries.",
          "enum": ["said", "pointed", "walked", "ran", "reproduced", null]
        },
        "rigor_source": {
          "description": "Where the recorded rung came from: model when the review set it, default when the checker filled said, verified reserved for later.",
          "enum": ["model", "default", "verified"]
        },
        "severity": {
          "enum": ["critical", "important", "informational", null]
        },
        "category": {
          "description": "Optional agent-supplied taxonomy; absent and null group as untagged in report, calibrate, and trend. Never part of the sig.",
          "enum": [
            "logic",
            "edge-case",
            "security",
            "performance",
            "accidental-commit",
            "style",
            "docs",
            "other",
            null
          ]
        },
        "withheld": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/withheld" }]
        },
        "status": {
          "enum": [
            "open",
            "addressed",
            "wont-fix",
            "false-positive",
            "deferred"
          ]
        },
        "firstSeen": { "type": "string" },
        "lastSeen": { "type": "string" },
        "rationale": { "type": "string" },
        "verification": {
          "type": "array",
          "items": { "$ref": "#/$defs/panelVerification" }
        },
        "confidence": { "enum": ["single", "confirmed", "contested"] },
        "triagedAt": { "type": "string" },
        "triagedBy": { "type": "string" },
        "history": {
          "description": "Append-only: reported, claim, reopened, revalidation, addressed, triaged.",
          "type": "array",
          "items": { "$ref": "#/$defs/historyEvent" }
        }
      },
      "required": [
        "sig",
        "sig_version",
        "kind",
        "status",
        "firstSeen",
        "lastSeen",
        "history"
      ],
      "additionalProperties": true
    },
    "withheld": {
      "type": "object",
      "properties": {
        "source": {
          "enum": ["exclusion", "agent", "below-severity", "validation"]
        },
        "reason": { "type": "string" },
        "exclusion_id": { "type": "string" },
        "at": { "type": "string" }
      },
      "required": ["source", "reason", "at"],
      "additionalProperties": true
    },
    "panelVerification": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string" },
        "verdict": { "enum": ["confirmed", "refuted", "insufficient"] },
        "evidence": { "type": "string", "maxLength": 500, "minLength": 10 },
        "at": { "type": "string" }
      },
      "required": ["model", "verdict", "evidence"],
      "additionalProperties": true
    },
    "brief": {
      "description": "The machine form of the finding: affected sites, the required outcome, an optional approach, and open questions.",
      "type": "object",
      "properties": {
        "sites": {
          "description": "Affected changed files with an optional reviewed line; a site outside every hunk warns and drops.",
          "type": "array",
          "items": { "$ref": "#/$defs/briefSite" }
        },
        "outcome": {
          "description": "One sentence naming what the fix must achieve — required, 10–500 characters.",
          "type": "string"
        },
        "approach": {
          "description": "Optional suggested approach, 10–1,000 characters.",
          "type": "string"
        },
        "questions": {
          "description": "Optional questions for the human, at most 10 of 10–300 characters each.",
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["outcome"],
      "additionalProperties": true
    },
    "briefSite": {
      "type": "object",
      "properties": {
        "path": { "description": "A changed file path.", "type": "string" },
        "line": {
          "description": "Reviewed line inside a hunk; absent means the whole file.",
          "type": ["integer", "null"]
        }
      },
      "required": ["path"],
      "additionalProperties": true
    },
    "historyEvent": {
      "type": "object",
      "properties": {
        "at": { "type": "string" },
        "event": {
          "enum": [
            "reported",
            "claim",
            "reopened",
            "revalidation",
            "addressed",
            "triaged",
            "withheld"
          ]
        },
        "actor": { "type": "string" },
        "note": { "type": "string" },
        "sha": { "type": "string" },
        "kb_credit": {
          "type": "array",
          "items": { "$ref": "#/$defs/kbCredit" }
        }
      },
      "required": ["at", "event"],
      "additionalProperties": true
    },
    "kbCredit": {
      "type": "object",
      "properties": {
        "rule": { "type": "string" },
        "to": { "type": "string" }
      },
      "required": ["rule", "to"],
      "additionalProperties": true
    }
  }
}
