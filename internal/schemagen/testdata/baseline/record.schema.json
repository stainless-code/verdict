{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stainless-code/verdict/blob/main/schemas/record.schema.json",
  "title": "record.json — completed-record (local bundles)",
  "description": "Written by the record verb in the verdict CLI for local and provider-PR bundles (GitHub PRs use post). findings/open are recomputed from the merged store every run; confidence/security_summary are null when the review carried none. additionalProperties stays open for additive provenance fields.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1" },
    "status": {
      "description": "Bundle provider that was recorded (e.g. local).",
      "type": "string"
    },
    "head": {
      "description": "Reviewed SHA (real head_sha, or \"dirty\"/\"unknown\" when the bundle has none).",
      "type": "string"
    },
    "diff_sha256": {
      "description": "SHA-256 of full.diff at record time.",
      "type": "string"
    },
    "review_sha256": { "type": "string" },
    "recorded_at": {
      "description": "UTC timestamp of the record run.",
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "description": "Total merged findings.",
      "type": "integer",
      "minimum": 0
    },
    "open": {
      "description": "Open findings after the merge.",
      "type": "integer",
      "minimum": 0
    },
    "confidence": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "security_summary": { "type": ["string", "null"] },
    "risk": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/riskClaim" }] },
    "tool_version": {
      "description": "Tool version that wrote this record (from package.json).",
      "type": "string"
    },
    "prompts_hash": {
      "description": "sha256 over the sorted prompt-set file names plus contents (SKILL.md plus prompts/system.md, prompts/review.md, prompts/diagrams.md).",
      "type": "string"
    },
    "model": {
      "description": "First model of the latest cost record, else null when no cost record names one.",
      "type": ["string", "null"]
    },
    "author": {
      "description": "The fetch fingerprint this bundle carried, copied from author.json; null when the bundle carries none, so an unknown author is never guessed as human.",
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/author" }]
    },
    "review_models": {
      "description": "Every model name the bundle's cost.json prices, deduplicated and sorted; empty when the cost record names none. The reviewer half of the author/reviewer pair.",
      "type": "array",
      "items": { "type": "string" }
    },
    "patch_id": {
      "description": "Bundle patch id at record time, copied from identity.json; absent when the bundle had no identity.",
      "type": ["string", "null"]
    },
    "patch_id_kind": {
      "description": "Patch id algorithm (git-patch-id or the labeled diff-sha256 fallback); absent when the bundle had no identity.",
      "type": "string"
    },
    "repairs": {
      "description": "Safe review.json rewrites applied before the merge, in document order; absent when the review was already clean.",
      "type": "array",
      "items": { "$ref": "#/$defs/repair" }
    },
    "verification": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/verificationSummary" }]
    },
    "coverage": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/coverageSummary" }]
    },
    "chunk_coverage": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/chunkCoverage" }]
    },
    "validation_hash": { "type": ["string", "null"] },
    "validation_counts": { "$ref": "#/$defs/validationCounts" },
    "validation_mode": { "enum": ["warn", "gate"] },
    "rigor_floors": { "$ref": "#/$defs/rigorFloors" },
    "approval": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/approvalReceipt" }]
    },
    "spec_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/specCheck" }
    },
    "receipts": {
      "type": "array",
      "items": { "$ref": "#/$defs/receipt" }
    }
  },
  "required": [
    "schema_version",
    "status",
    "head",
    "diff_sha256",
    "recorded_at",
    "findings",
    "open",
    "author",
    "review_models",
    "validation_hash",
    "validation_counts",
    "validation_mode",
    "rigor_floors"
  ],
  "additionalProperties": true,
  "$defs": {
    "author": {
      "type": "object",
      "properties": {
        "agent": {
          "description": "Agent the fingerprint named: claude, codex, or cursor. Advisory only: it groups history and suggests a reviewer family, and nothing routes on it.",
          "type": "string"
        },
        "model": {
          "description": "Model the fingerprint named, else null when the signal named only the agent.",
          "type": ["string", "null"]
        }
      },
      "required": ["agent", "model"],
      "additionalProperties": true
    },
    "repair": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "enum-synonym",
            "key-alias",
            "normalized-extracted",
            "normalized-fence",
            "normalized-trivia",
            "scalar-to-array"
          ]
        },
        "path": { "type": "string" }
      },
      "required": ["code", "path"],
      "additionalProperties": true
    },
    "coverageSummary": {
      "type": "object",
      "properties": {
        "percent": { "type": ["integer", "null"] },
        "attested": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "exempt": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "integer", "minimum": 0 }
      },
      "required": ["percent", "attested", "total", "files", "exempt", "gaps"],
      "additionalProperties": true
    },
    "verificationSummary": {
      "type": "object",
      "properties": {
        "verifiers": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "contested": { "type": "integer", "minimum": 0 },
        "single": { "type": "integer", "minimum": 0 }
      },
      "required": ["verifiers", "confirmed", "contested", "single"],
      "additionalProperties": true
    },
    "chunkCoverage": {
      "type": "object",
      "properties": {
        "attested": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "required": ["attested", "total"],
      "additionalProperties": true
    },
    "riskClaim": {
      "type": "object",
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "rationale": { "type": "string" },
        "assessed_head": { "type": "string" },
        "stale": { "type": "boolean" }
      },
      "required": ["level", "rationale", "assessed_head"],
      "additionalProperties": true
    },
    "approvalReceipt": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" },
        "tier": { "enum": ["critical", "important", "informational"] },
        "gating_sigs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "clauses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approved": { "type": "boolean" }
      },
      "required": ["reason", "tier", "gating_sigs", "approved"],
      "additionalProperties": true
    },
    "specCheck": {
      "type": "object",
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "status": { "enum": ["met", "violated", "n/a"] },
        "evidence": { "$ref": "#/$defs/specEvidence" }
      },
      "required": ["item", "status", "evidence"],
      "additionalProperties": true
    },
    "specEvidence": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "quote": { "type": "string", "minLength": 1 },
        "line": { "type": "integer" }
      },
      "required": ["path", "quote", "line"],
      "additionalProperties": true
    },
    "receipt": {
      "type": "object",
      "properties": {
        "hunk": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 }
      },
      "required": ["hunk", "quote"],
      "additionalProperties": true
    },
    "validationCounts": {
      "type": "object",
      "properties": {
        "confirmed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "downgraded": { "type": "integer", "minimum": 0 },
        "unvalidated": { "type": "integer", "minimum": 0 }
      },
      "required": ["confirmed", "rejected", "downgraded", "unvalidated"],
      "additionalProperties": true
    },
    "rigorFloors": {
      "type": "object",
      "properties": {
        "critical": {
          "enum": ["said", "pointed", "walked", "ran", "reproduced"]
        },
        "important": {
          "enum": ["said", "pointed", "walked", "ran", "reproduced"]
        },
        "informational": {
          "enum": ["said", "pointed", "walked", "ran", "reproduced"]
        }
      },
      "required": ["critical", "important", "informational"],
      "additionalProperties": true
    }
  }
}
