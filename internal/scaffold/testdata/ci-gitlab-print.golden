--- .gitlab/ci/verdict-review.yml (rendered) ---
# Generated by `verdict init --ci gitlab`. Review before committing.
#
# Commit this file: every merge request then runs verdict on your runner with
# your agent and your own model key. Regenerate after upgrading verdict.

verdict-review:
  stage: test
  # Merge request pipelines only. The second clause drops the one pipeline a
  # parent-project member can trigger for a merge request from a fork: there
  # GitLab runs this project's variables against the fork's code.
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event" && $CI_MERGE_REQUEST_SOURCE_PROJECT_PATH == $CI_PROJECT_PATH'
  variables:
    # The review controls are read from the merge request base commit
    # (git show <base>:<path>), so the clone must hold the history.
    GIT_DEPTH: "0"
    VERDICT_REPOSITORY: $CI_PROJECT_PATH
    VERDICT_PR: $CI_MERGE_REQUEST_IID
    VERDICT_AGENT: claude
    GITLAB_HOST: $CI_SERVER_FQDN
  interruptible: true
  timeout: 30 minutes
  script:
    # Install verdict from the installer pinned at the release this build
    # ships. VERDICT_VERSION is a CI/CD variable: a release tag, or unset for
    # latest.
    - |
      curl -fsSL "https://raw.githubusercontent.com/stainless-code/verdict/b4c36344f03375985a8edf859b9092ba7d59f077/install.sh" \
        | VERDICT_NO_MODIFY_PATH=1 VERDICT_VERSION="${VERDICT_VERSION:-latest}" sh
      export PATH="$HOME/.verdict/bin:$PATH"
    # Install glab on the runner before this pipeline: verdict installs itself
    # and never downloads a host CLI.
    #   https://gitlab.com/gitlab-org/cli/-/releases
    - |
      verdict skill install --agent "$VERDICT_AGENT"
    - |
      verdict fetch "$VERDICT_REPOSITORY" "$VERDICT_PR" --provider gitlab
    - |
      verdict ready "$VERDICT_REPOSITORY" "$VERDICT_PR" --check
    - |
      # Install claude on the runner before this step: verdict installs
      # itself and never downloads an agent CLI.
      #   curl -fsSL https://claude.ai/install.sh | bash
      # verdict never bakes a permission flag: this agent's documented one is --permission-mode acceptEdits,
      # appended by you inside agent_args when the run needs it.
      (
        unset GITLAB_TOKEN GLAB_TOKEN GITLAB_ACCESS_TOKEN OAUTH_TOKEN CI_JOB_TOKEN GLAB_ENABLE_CI_AUTOLOGIN GH_TOKEN GITHUB_TOKEN
        agent_args=()
        if [ -n "${VERDICT_MODEL:-}" ]; then agent_args=(-- --model "$VERDICT_MODEL"); fi
        verdict run "$VERDICT_REPOSITORY" "$VERDICT_PR" --agent "$VERDICT_AGENT" "${agent_args[@]}"
      )
    - |
      verdict post "$VERDICT_REPOSITORY" "$VERDICT_PR"
    - |
      verdict report "$VERDICT_REPOSITORY" "$VERDICT_PR"
    - |
      verdict gate "$VERDICT_REPOSITORY" "$VERDICT_PR" \
        --max-severity critical --require-head --live auto
--- .gitlab-ci.yml (created only when absent; never overwritten) ---
# Generated by `verdict init --ci gitlab`. Review before committing.
#
# Commit this file: every merge request then runs verdict on your runner with
# your agent and your own model key. Regenerate after upgrading verdict.

# One include, so this file stays yours to edit. Delete the include to turn
# the automatic review off; .gitlab/ci/verdict-review.yml is the pipeline.

include:
  - local: .gitlab/ci/verdict-review.yml
