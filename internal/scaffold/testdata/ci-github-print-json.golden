--- stdout ---
{
  "schema_version": "1",
  "verb": "init",
  "repo": "",
  "pr": null,
  "at": "0000-00-00T00:00:00Z",
  "next": "write it with: verdict init --ci github",
  "warnings": [],
  "data": {
    "preset": "standard",
    "budget_usd": "0.50",
    "kb_min_judged": 5,
    "kb_max_fp_rate": 0.5,
    "files": [],
    "check_tree_clean": false,
    "ci": "github",
    "workflow_path": ".github/workflows/verdict-review.yml",
    "workflow": "# Generated by `verdict init --ci github`. Review before committing.\n#\n# Commit this file: every pull request then runs verdict on your runner with\n# your agent and your own model key. Regenerate after upgrading verdict.\n\nname: verdict review\n\non:\n  pull_request:\n    types: [opened, synchronize, reopened]\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: verdict-${{ github.event.pull_request.number }}\n  cancel-in-progress: true\n\njobs:\n  review:\n    name: review + merge gate\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    permissions:\n      contents: read\n      pull-requests: write\n    # Fork pull requests get no repository secrets and a read-only token, so\n    # the agent step cannot start there. Remove this line only to opt in with\n    # a token and key you control for untrusted code. A skipped job reads as a\n    # pass to branch protection.\n    if: github.event.pull_request.head.repo.full_name == github.repository\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7\n        with:\n          # The review controls are read from the PR base commit\n          # (git show <base>:<path>), so the checkout must hold it.\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Install verdict\n        uses: stainless-code/verdict/setup-verdict@b4c36344f03375985a8edf859b9092ba7d59f077 # vVERSION\n        with:\n          version: ${{ vars.VERDICT_VERSION }}\n\n      - name: Install the review skill\n        env:\n          VERDICT_AGENT: claude\n        shell: bash\n        run: |\n          verdict skill install --agent \"$VERDICT_AGENT\"\n\n      - name: Fetch the PR bundle\n        env:\n          VERDICT_REPOSITORY: ${{ github.repository }}\n          VERDICT_PR: ${{ github.event.pull_request.number }}\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        shell: bash\n        run: |\n          verdict fetch \"$VERDICT_REPOSITORY\" \"$VERDICT_PR\"\n\n      - name: Readiness pre-check (saves agent spend)\n        env:\n          VERDICT_REPOSITORY: ${{ github.repository }}\n          VERDICT_PR: ${{ github.event.pull_request.number }}\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        shell: bash\n        run: |\n          verdict ready \"$VERDICT_REPOSITORY\" \"$VERDICT_PR\" --check\n\n      - name: Agent review (verdict run --agent, your agent + your key)\n        env:\n          VERDICT_REPOSITORY: ${{ github.repository }}\n          VERDICT_PR: ${{ github.event.pull_request.number }}\n          VERDICT_AGENT: claude\n          VERDICT_MODEL: ${{ vars.VERDICT_MODEL }}\n          GH_TOKEN: \"\"\n          GITHUB_TOKEN: \"\"\n          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}\n        shell: bash\n        run: |\n          # Install claude on the runner before this step: verdict installs\n          # itself and never downloads an agent CLI.\n          #   curl -fsSL https://claude.ai/install.sh | bash\n          # verdict adds only a write scoped to the review bundle (--allowedTools=Edit(./.verdict/state/<pr>/**));\n          # this agent's broader documented flag, --permission-mode acceptEdits, stays yours to append inside agent_args.\n          agent_args=()\n          if [ -n \"${VERDICT_MODEL:-}\" ]; then agent_args=(-- --model \"$VERDICT_MODEL\"); fi\n          verdict run \"$VERDICT_REPOSITORY\" \"$VERDICT_PR\" --agent \"$VERDICT_AGENT\" \"${agent_args[@]}\"\n\n      - name: Post the review\n        env:\n          VERDICT_REPOSITORY: ${{ github.repository }}\n          VERDICT_PR: ${{ github.event.pull_request.number }}\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        shell: bash\n        run: |\n          verdict post \"$VERDICT_REPOSITORY\" \"$VERDICT_PR\"\n\n      - name: Review summary (advisory, never gates)\n        env:\n          VERDICT_REPOSITORY: ${{ github.repository }}\n          VERDICT_PR: ${{ github.event.pull_request.number }}\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        shell: bash\n        run: |\n          verdict report \"$VERDICT_REPOSITORY\" \"$VERDICT_PR\"\n\n      - name: Merge gate (findings + freshness + coverage + live threads)\n        env:\n          VERDICT_REPOSITORY: ${{ github.repository }}\n          VERDICT_PR: ${{ github.event.pull_request.number }}\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        shell: bash\n        run: |\n          verdict gate \"$VERDICT_REPOSITORY\" \"$VERDICT_PR\" \\\n            --max-severity critical --require-head --live auto\n"
  },
  "error": null
}
