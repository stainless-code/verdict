exit: 0
--- stdout ---
# Generated by `verdict init --ci github`. Review before committing.
#
# Commit this file: every pull request then runs verdict on your runner with
# your agent and your own model key. Regenerate after upgrading verdict.
# Add a `/verdict` comment on a pull request to re-run the review.

name: verdict review

on:
  pull_request:
    types: [opened, synchronize, reopened]
  issue_comment:
    types: [created]

permissions:
  contents: read

concurrency:
  # Three routes: a pull_request run keeps verdict-<number> (its check run is
  # the required one, pinned to the PR head SHA), a /verdict comment gets
  # verdict-comment-<number> (it supersedes older comment runs, never the
  # required check), and any other comment gets a run-unique no-op group.
  group: ${{ (github.event_name == 'pull_request' && format('verdict-{0}', github.event.pull_request.number)) || ((github.event.issue.pull_request != null && contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association) && (github.event.comment.body == '/verdict' || startsWith(github.event.comment.body, '/verdict '))) && format('verdict-comment-{0}', github.event.issue.number)) || format('verdict-noop-{0}', github.run_id) }}
  cancel-in-progress: true

jobs:
  review:
    name: review + merge gate
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      pull-requests: write
    # Fork pull requests get no repository secrets and a read-only token, so
    # the agent step cannot start there. Remove this line only to opt in with
    # a token and key you control for untrusted code. A skipped job reads as a
    # pass to branch protection.
    if: |
      (github.event_name == 'pull_request' &&
       github.event.pull_request.head.repo.full_name == github.repository) ||
      (github.event_name == 'issue_comment' &&
       github.event.issue.pull_request != null &&
       contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association) &&
       (github.event.comment.body == '/verdict' || startsWith(github.event.comment.body, '/verdict ')))
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The review controls are read from the PR base commit
          # (git show <base>:<path>), so the checkout must hold it.
          fetch-depth: 0
          persist-credentials: false

      - name: Install verdict
        uses: stainless-code/verdict/setup-verdict@b4c36344f03375985a8edf859b9092ba7d59f077 # vVERSION
        with:
          version: ${{ vars.VERDICT_VERSION }}

      - name: Install the review skill
        env:
          VERDICT_AGENT: claude
        shell: bash
        run: |
          verdict skill install --agent "$VERDICT_AGENT"

      - name: Fetch the PR bundle
        env:
          VERDICT_REPOSITORY: ${{ github.repository }}
          VERDICT_PR: ${{ github.event.pull_request.number || github.event.issue.number }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        shell: bash
        run: |
          verdict fetch "$VERDICT_REPOSITORY" "$VERDICT_PR"

      - name: Readiness pre-check (saves agent spend)
        env:
          VERDICT_REPOSITORY: ${{ github.repository }}
          VERDICT_PR: ${{ github.event.pull_request.number || github.event.issue.number }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        shell: bash
        run: |
          verdict ready "$VERDICT_REPOSITORY" "$VERDICT_PR" --check

      - name: Agent review (verdict run --agent, your agent + your key)
        env:
          VERDICT_REPOSITORY: ${{ github.repository }}
          VERDICT_PR: ${{ github.event.pull_request.number || github.event.issue.number }}
          VERDICT_AGENT: claude
          VERDICT_MODEL: ${{ vars.VERDICT_MODEL }}
          GH_TOKEN: ""
          GITHUB_TOKEN: ""
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        shell: bash
        run: |
          # Install claude on the runner before this step: verdict installs
          # itself and never downloads an agent CLI.
          #   curl -fsSL https://claude.ai/install.sh | bash
          # verdict never bakes a permission flag: this agent's documented one is --permission-mode acceptEdits,
          # appended by you inside agent_args when the run needs it.
          agent_args=()
          if [ -n "${VERDICT_MODEL:-}" ]; then agent_args=(-- --model "$VERDICT_MODEL"); fi
          verdict run "$VERDICT_REPOSITORY" "$VERDICT_PR" --agent "$VERDICT_AGENT" "${agent_args[@]}"

      - name: Post the review
        env:
          VERDICT_REPOSITORY: ${{ github.repository }}
          VERDICT_PR: ${{ github.event.pull_request.number || github.event.issue.number }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        shell: bash
        run: |
          verdict post "$VERDICT_REPOSITORY" "$VERDICT_PR"

      - name: Review summary (advisory, never gates)
        env:
          VERDICT_REPOSITORY: ${{ github.repository }}
          VERDICT_PR: ${{ github.event.pull_request.number || github.event.issue.number }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        shell: bash
        run: |
          verdict report "$VERDICT_REPOSITORY" "$VERDICT_PR"

      - name: Merge gate (findings + freshness + coverage + live threads)
        env:
          VERDICT_REPOSITORY: ${{ github.repository }}
          VERDICT_PR: ${{ github.event.pull_request.number || github.event.issue.number }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        shell: bash
        run: |
          verdict gate "$VERDICT_REPOSITORY" "$VERDICT_PR" \
            --max-severity critical --require-head --live auto
--- stderr ---

--- files ---
