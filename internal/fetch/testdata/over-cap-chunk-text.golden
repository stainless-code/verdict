--- file C/.gh-calls.log ---
CALL: pr view 4703 --repo acme/app --json number,title,body,baseRefName,headRefName,headRefOid,baseRefOid,author,url,commits,files,additions,deletions,isDraft,reviewDecision,state
CALL: pr diff 4703 --repo acme/app
CALL: pr view 4703 --repo acme/app --json files --jq .files[] | "\(.path) (+\(.additions)/-\(.deletions))"
CALL: api repos/acme/app/pulls/4703/reviews --paginate
CALL: api repos/acme/app/pulls/4703/comments --paginate
CALL: api graphql -F owner=acme -F name=app -F pr=4703 -f query=
      query($owner:String!, $name:String!, $pr:Int!, $endCursor:String) {
        repository(owner:$owner, name:$name) {
          pullRequest(number:$pr) {
            reviewThreads(first:100, after:$endCursor) {
              pageInfo { hasNextPage endCursor }
              nodes {
                id
                isResolved
                isOutdated
                path
                line
                startLine
                diffSide
                comments(first:100) {
                  totalCount
                  nodes { id databaseId author { __typename login } body createdAt url }
                }
              }
            }
          }
        }
      }
