# Bundles, run state, and review controls all live under .review/: cwd-local
# state, never committed. An ignored path is the whole rule; no negation
# re-admits a control file.
.review/
.env
.env.local
.DS_Store
node_modules/
dist/
.blume/
.blume-verify/
pack.log
# Local-only working notes (strategy, scratch). Never commit.
.agents/local/
# Go build output: `make build` writes bin/verdict, the binary every eval
# case invokes. Never commit binaries.
# Never commit binaries.
bin/

# Python bytecode from examples/python-client.
__pycache__/

# The skill dir ships tracked files only. Dev state beside SKILL.md stays out:
# `make build` links bin -> ../../bin (a symlink, which `bin/` above does not
# match), and a bootstrapped copy writes bin/ and a receipt.
skills/verdict/bin
skills/verdict/.verdict-managed
