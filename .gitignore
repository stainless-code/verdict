# Bundles and run state stay ignored; the review controls are tracked so the
# PR base commit carries them (negations need `.review/*`, not `.review/`).
.review/*
!.review/kb.jsonl
!.review/learnings.md
!.review/panel
!.review/budget
!.review/kb-policy
!.review/max_bytes
!.review/chunk
!.review/overrides/
!.review/overrides/*.md
.env
.env.local
.DS_Store
node_modules/
dist/
.blume/
.blume-verify/
pack.log
# Local-only working notes (strategy, scratch). Never commit.
.agents/local/
# Go build output (go-port 02): `make build` writes bin/verdict, the
# repo-local binary the shell dispatches to under VERDICT_IMPL=go.
# Never commit binaries.
bin/

# Python bytecode from examples/python-client.
__pycache__/
