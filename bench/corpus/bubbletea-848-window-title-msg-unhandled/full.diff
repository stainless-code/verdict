+// print string after stopping for a certain period of time
+func SleepPrintln(s string, milisecond int) tea.Cmd {
+	printCmd := tea.Println(s)
+	return func() tea.Msg {
+		time.Sleep(time.Duration(milisecond) * time.Millisecond)
+		return printCmd()
+	}
+}
