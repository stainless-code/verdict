+func TestGetZipLogMap(t *testing.T) {
+	tests := []struct {
+		name      string
+		job       shared.Job
+		zipReader *zip.Reader
+		// wantJobLog can be nil (i.e. not found) or string
+		wantJobLog any
+		// wantStepLogs elements can be nil (i.e. not found) or string
+		wantStepLogs []any
