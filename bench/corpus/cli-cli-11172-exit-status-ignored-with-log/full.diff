+					require.NotNil(t, stepLogFile)
+
+					gotStepLog := readZipFile(t, stepLogFile)
+					require.Equal(t, want, string(gotStepLog))
+				default:
+					t.Fatal("wantStepLog must be nil or string")
+				}
+			}
