+			case string:
+				require.True(t, ok)
+				require.NotNil(t, jobLogFile)
+				require.Equal(t, want, string(readZipFile(t, jobLogFile)))
+			default:
+				t.Fatal("wantJobLog must be nil or string")
+			}
+
