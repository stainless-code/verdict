+				Steps: []shared.Step{{
+					Name:   "step one",
+					Number: 1,
+				}},
+			},
+			zipReader: createZipReader(t, map[string]string{
+				"0_job foo.txt":          "job log",
+				"job foo/1_step one.txt": "step one log",
+			}),
+			wantJobLog: "job log",
+			wantStepLogs: []any{
+				"step one log",
+			},
+		},
+		{
