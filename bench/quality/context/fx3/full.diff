+          "mean": 0.2667,
+          "union": 1.0,
+          "union_hits": ["K1","K2","K3","K4","K5"]
+        },
+        "bonus_union": {"count": 0, "hits": []},
+        "false_green": {"passes": 3, "measured": 5, "unknown": 1, "rate": 0.6},
+        "hallucination": {"rate": null, "status": "stubbed", "gating_findings": 5, "checked": 0},
