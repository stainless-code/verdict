+  "schema_version": "1",
+  "verb": "backtest",
+  "at": "2026-11-18T00:00:00Z",
+  "next": "inspect .verdict/backtest/quality/report.json; rates describe recorded reviews and fixture defects",
+  "warnings": [],
+  "data": {
+    "schema_version": "1",
+    "mode": "quality",
+    "recordings": 7,
+    "scored": 7,
+    "fixtures": [
+      {
+        "id": "fx1",
+        "label": "STA-440 part 2, first build (291c83ae5..98d8becd9)",
+        "runs": 6,
+        "scored": 6,
+        "known": 5,
+        "bonus": 2,
+        "recall": {
