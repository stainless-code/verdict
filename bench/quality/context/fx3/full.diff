new file mode 100644
index 000000000..fd8c38874
--- /dev/null
+++ b/internal/core/quality/metrics.go
@@ -0,0 +1,311 @@
+package quality
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+
+	corpuscore "github.com/stainless-code/verdict/internal/core/corpus"
+	"github.com/stainless-code/verdict/internal/jq"
+)
+
+const (
+	quoteUnsupported    = "unsupported"
+	quoteMatched        = "matched"
+	quoteMismatch       = "mismatch"
+	quoteNoQuote        = "no-quote"
+	hallucStubbed       = "stubbed"
+	hallucMeasured      = "measured"
+	refusalInsufficient = "review-insufficient"
+	rateBits            = 64
+	notApplicable       = "n/a"
+)
+
+// IsGatingFinding is the one predicate S4 retargets: a gating finding is
+// critical or important, anchored, and not marked unverified. No other call
+// site decides which findings a quote verifier sees.
+func IsGatingFinding(f *Finding) bool {
+	switch strings.ToLower(f.Severity) {
+	case "critical", "important":
+	default:
+		return false
+	}
+	if f.Anchored == nil || !*f.Anchored {
+		return false
+	}
+	return f.Refusal != "unverified"
+}
+
+// QuoteResult is one verifier answer. S4's anchored quote check lands behind
+// this same interface without changing the report shape.
+type QuoteResult struct {
+	Status string
+	Reason string
+}
+
+// QuoteVerifier checks one finding's quote against the pinned fixture head
+// material. Only explicit "matched" and "mismatch" results are verified;
+// "no-quote", "unsupported" and unknown results are unverifiable.
+type QuoteVerifier interface {
+	Verify(ctx context.Context, f *Finding, head []byte) QuoteResult
+}
+
+// StubVerifier reports that S4's quote verification has not shipped. S6
+// publishes a null hallucination rate, never a zero.
+type StubVerifier struct{}
+
+// Verify implements QuoteVerifier.
+func (StubVerifier) Verify(_ context.Context, _ *Finding, _ []byte) QuoteResult {
+	return QuoteResult{Status: quoteUnsupported, Reason: "S4 quote verification has not shipped"}
+}
+
+// RecallReport is the fixture's recall over scored runs. A nil rate means the
+// denominator was zero, not that recall was zero.
+type RecallReport struct {
+	PerRun    []float64 `json:"per_run"`
+	Mean      *float64  `json:"mean"`
+	Union     *float64  `json:"union"`
+	UnionHits []string  `json:"union_hits"`
+}
+
+// BonusReport reports bonus defects separately; they never enter recall.
+type BonusReport struct {
+	Hits  []string `json:"hits"`
+	Count int      `json:"count"`
+}
+
+// FalseGreenReport is the measured gate-pass rate. Unknown gate outcomes are
+// listed but excluded from the denominator.
+type FalseGreenReport struct {
+	Rate     *float64 `json:"rate"`
+	Passes   int      `json:"passes"`
+	Measured int      `json:"measured"`
+	Unknown  int      `json:"unknown"`
+}
+
+// HallucinationReport counts explicitly verified quotes only. A finding whose
+// quote cannot be checked is unverifiable, never a clean check.
+type HallucinationReport struct {
+	Rate           *float64 `json:"rate"`
+	Status         string   `json:"status"`
+	GatingFindings int      `json:"gating_findings"`
+	Checked        int      `json:"checked"`
+	Unverifiable   int      `json:"unverifiable"`
+}
+
+// CalibrationReport summarizes the hand-score rows.
+type CalibrationReport struct {
+	Mismatches []string `json:"mismatches"`
+	Rows       int      `json:"rows"`
+	Reproduced bool     `json:"reproduced"`
+}
+
+// FixtureReport is one fixture's published metrics.
+type FixtureReport struct {
+	FalseGreen         FalseGreenReport    `json:"false_green"`
+	ID                 string              `json:"id"`
+	Label              string              `json:"label"`
+	Recall             RecallReport        `json:"recall"`
+	BonusUnion         BonusReport         `json:"bonus_union"`
+	Hallucination      HallucinationReport `json:"hallucination"`
+	Runs               int                 `json:"runs"`
+	Scored             int                 `json:"scored"`
+	Known              int                 `json:"known"`
+	Bonus              int                 `json:"bonus"`
+	ReviewInsufficient int                 `json:"review_insufficient"`
+}
+
+// Diagnostic is one run's matcher output, kept beside the rates so a reader
+// can audit a surprising hit without opening the recording.
+type Diagnostic struct {
+	GatePassed    *bool    `json:"gate_passed"`
+	Recording     string   `json:"recording"`
+	Fixture       string   `json:"fixture"`
+	InfraError    string   `json:"infra_error"`
+	Hits          []string `json:"hits"`
+	Praise        int      `json:"praise"`
+	NullSeverity  int      `json:"null_severity"`
+	OtherFindings int      `json:"other_findings"`
+	Scored        bool     `json:"scored"`
+}
+
+// Report is the `backtest fixtures` data object, also written to
+// .verdict/backtest/fixtures/report.json.
+type Report struct {
+	SchemaVersion string            `json:"schema_version"`
+	Mode          string            `json:"mode"`
+	Fixtures      []FixtureReport   `json:"fixtures"`
+	Diagnostics   []Diagnostic      `json:"diagnostics"`
+	Calibration   CalibrationReport `json:"calibration"`
+	Recordings    int               `json:"recordings"`
+	Scored        int               `json:"scored"`
+}
+
+// Wire renders the report in the published key order.
+func (r *Report) Wire() *jq.Obj {
+	fixtures := make([]any, 0, len(r.Fixtures))
+	for i := range r.Fixtures {
+		fixtures = append(fixtures, r.Fixtures[i].Wire())
+	}
+	diagnostics := make([]any, 0, len(r.Diagnostics))
+	for i := range r.Diagnostics {
+		diagnostics = append(diagnostics, r.Diagnostics[i].Wire())
+	}
+	return jq.NewObj(
+		"schema_version", r.SchemaVersion,
+		"mode", r.Mode,
+		"recordings", r.Recordings,
+		"scored", r.Scored,
+		"fixtures", fixtures,
+		"calibration", r.Calibration.Wire(),
+		"diagnostics", diagnostics,
+	)
+}
+
+// Wire renders one fixture's metrics in the published key order.
+func (r *FixtureReport) Wire() *jq.Obj {
+	perRun := make([]any, 0, len(r.Recall.PerRun))
+	for _, rate := range r.Recall.PerRun {
+		perRun = append(perRun, rate)
+	}
+	return jq.NewObj(
+		"id", r.ID,
+		"label", r.Label,
+		"runs", r.Runs,
+		"scored", r.Scored,
+		"known", r.Known,
+		"bonus", r.Bonus,
+		"recall", jq.NewObj(
+			"per_run", perRun,
+			"mean", optionalFloatPtr(r.Recall.Mean),
+			"union", optionalFloatPtr(r.Recall.Union),
+			"union_hits", stringsValue(r.Recall.UnionHits),
+		),
+		"bonus_union", jq.NewObj("count", r.BonusUnion.Count, "hits", stringsValue(r.BonusUnion.Hits)),
+		"false_green", jq.NewObj(
+			"passes", r.FalseGreen.Passes,
+			"measured", r.FalseGreen.Measured,
+			"unknown", r.FalseGreen.Unknown,
+			"rate", optionalFloatPtr(r.FalseGreen.Rate),
+		),
+		"hallucination", jq.NewObj(
+			"rate", optionalFloatPtr(r.Hallucination.Rate),
+			"status", r.Hallucination.Status,
+			"gating_findings", r.Hallucination.GatingFindings,
+			"checked", r.Hallucination.Checked,
+			"unverifiable", r.Hallucination.Unverifiable,
+		),
+		"review_insufficient", r.ReviewInsufficient,
+	)
+}
+
+// Wire renders one diagnostic in the published key order.
+func (r *Diagnostic) Wire() *jq.Obj {
+	return jq.NewObj(
+		"recording", r.Recording,
+		"fixture", r.Fixture,
+		"hits", stringsValue(r.Hits),
+		"praise", r.Praise,
+		"null_severity", r.NullSeverity,
+		"other_findings", r.OtherFindings,
+		"gate_passed", optionalBool(r.GatePassed),
+		"infra_error", r.InfraError,
+		"scored", r.Scored,
+	)
+}
+
+// Wire renders the calibration summary in the published key order.
+func (r *CalibrationReport) Wire() *jq.Obj {
+	return jq.NewObj(
+		"rows", r.Rows,
+		"reproduced", r.Reproduced,
+		"mismatches", stringsValue(r.Mismatches),
+	)
+}
+
+func stringsValue(values []string) []any {
+	out := make([]any, 0, len(values))
+	for _, v := range values {
+		out = append(out, v)
+	}
+	return out
+}
+
+func optionalFloatPtr(v *float64) any {
+	if v == nil {
+		return nil
+	}
+	return *v
+}
+
+func optionalBool(v *bool) any {
+	if v == nil {
+		return nil
+	}
+	return *v
+}
+
+func ratePtr(n, d int) *float64 {
+	if d == 0 {
+		return nil
+	}
+	rate, ok := corpuscore.Rate(n, d)
+	if !ok {
+		return nil
+	}
+	return &rate
+}
+
+func roundRate(v float64) float64 {
+	scale := math.Pow10(corpuscore.RateDecimals)
+	return math.Round(v*scale) / scale
+}
+
+func rateText(v *float64) string {
+	if v == nil {
+		return notApplicable
+	}
+	return strconv.FormatFloat(*v, 'f', corpuscore.RateDecimals, rateBits)
+}
+
+func countNoun(n int, noun string) string {
+	if n == 1 {
+		return "1 " + noun
+	}
+	return strconv.Itoa(n) + " " + noun + "s"
+}
+
+func unknownText(n int) string {
+	if n == 1 {
+		return "1 unknown gate outcome"
+	}
+	return strconv.Itoa(n) + " unknown gate outcomes"
+}
+
+// Human renders the frozen human block from the report data.
+func Human(r *Report) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "backtest fixtures  (%d fixtures, %d recorded reviews, %d scored)\n",
+		len(r.Fixtures), r.Recordings, r.Scored)
+	for i := range r.Fixtures {
+		f := &r.Fixtures[i]
+		fmt.Fprintf(&sb, "%s  %s  (%s, %d scored)\n", f.ID, f.Label,
+			countNoun(f.Runs, "recording"), f.Scored)
+		perRun := make([]string, 0, len(f.Recall.PerRun))
+		for _, rate := range f.Recall.PerRun {
+			perRun = append(perRun, rateText(&rate))
+		}
+		fmt.Fprintf(&sb, "  recall per run: %s  mean: %s  union: %s (N=%d, %d known defects)\n",
+			strings.Join(perRun, " "), rateText(f.Recall.Mean), rateText(f.Recall.Union), len(perRun), f.Known)
+		fmt.Fprintf(&sb, "  bonus union: %d/%d  false green: %d/%d (%s)\n",
+			f.BonusUnion.Count, f.Bonus, f.FalseGreen.Passes, f.FalseGreen.Measured, unknownText(f.FalseGreen.Unknown))
+		fmt.Fprintf(&sb, "  hallucination: %s (%s; %d gating findings, %d checked, %d unverifiable)  review-insufficient: %d\n",
+			rateText(f.Hallucination.Rate), f.Hallucination.Status, f.Hallucination.GatingFindings,
+			f.Hallucination.Checked, f.Hallucination.Unverifiable, f.ReviewInsufficient)
+	}
+	fmt.Fprintf(&sb, "calibration: %d/%d rows reproduced\n", r.Calibration.Rows-len(r.Calibration.Mismatches), r.Calibration.Rows)
+	sb.WriteString("known defects from fixture manifests; rates describe recorded reviews, not a model claim\n")
+	return sb.String()
+}
diff --git a/internal/core/quality/recording.go b/internal/core/quality/recording.go
new file mode 100644
index 000000000..7f18c6707
--- /dev/null
+++ b/internal/core/quality/recording.go
@@ -0,0 +1,124 @@
+package quality
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/stainless-code/verdict/internal/core"
+	"github.com/stainless-code/verdict/internal/jq"
+)
+
+const (
+	metaSuffix    = ".meta.json"
+	recordingExt  = ".json"
+	fixtureFormat = "fixture-recording-v1"
+)
+
+// FixtureRecording is the corpus's own input shape: a flat list of findings
+// and the gate outcome. There is no reader for any other review format.
+type FixtureRecording struct {
+	GatePassed    *bool            `json:"gate_passed"`
+	SchemaVersion string           `json:"schema_version"`
+	Findings      []FixtureFinding `json:"findings"`
+}
+
+// FixtureFinding is one finding in a fixture recording. Line is carried for
+// provenance only; matching uses Path and Text.
+type FixtureFinding struct {
+	Severity *string `json:"severity"`
+	Line     *int    `json:"line"`
+	Path     string  `json:"path"`
+	Text     string  `json:"text"`
+}
+
+// LoadFixtureRecording reads one fixture-format recording with strict JSON.
+func LoadFixtureRecording(path string) (*FixtureRecording, *core.RefusalError) {
+	raw, err := jq.CappedFile(path, maxReviewBytes)
+	if err != nil {
+		return nil, invalidRecording(path, "unreadable fixture recording")
+	}
+	var rec FixtureRecording
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&rec); err != nil {
+		return nil, invalidRecording(path, "unreadable fixture recording: "+err.Error())
+	}
+	var extra any
+	if err := dec.Decode(&extra); !errors.Is(err, io.EOF) {
+		return nil, invalidRecording(path, "trailing data after fixture recording")
+	}
+	if err := validateRecording(&rec, path); err != nil {
+		return nil, err
+	}
+	return &rec, nil
+}
+
+func validateRecording(rec *FixtureRecording, path string) *core.RefusalError {
+	if rec.SchemaVersion != schemaVersion {
+		return invalidRecording(path, `missing schema_version "1"`)
+	}
+	for i := range rec.Findings {
+		if rec.Findings[i].Path == "" || rec.Findings[i].Text == "" {
+			return invalidRecording(path, "finding without path or text")
+		}
+	}
+	return nil
+}
+
+// Canonical converts one fixture finding into the scorer's input shape. A
+// positive line makes the finding anchored, which is what the gating
+// predicate and the S4 quote verifier see.
+func (f *FixtureFinding) Canonical() Finding {
+	anchored := f.Line != nil && *f.Line > 0
+	return Finding{
+		Path: f.Path, Claim: f.Text, Severity: stringOf(f.Severity),
+		Line: intOf(f.Line), Anchored: &anchored,
+	}
+}
+
+func intOf(v *int) int {
+	if v == nil {
+		return 0
+	}
+	return *v
+}
+
+// RecordingFiles lists the fixture recordings under one fixture's directory.
+// Meta files are the sidecars, never scorer input.
+func RecordingFiles(dir string) ([]string, *core.RefusalError) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil, nil
+		}
+		return nil, invalidRecording(dir, "unreadable recordings directory")
+	}
+	var files []string
+	for _, entry := range entries {
+		name := entry.Name()
+		if entry.IsDir() || !strings.HasSuffix(name, recordingExt) || strings.HasSuffix(name, metaSuffix) ||
+			strings.HasPrefix(name, ".") || name != filepath.Base(name) {
+			continue
+		}
+		files = append(files, filepath.Join(dir, name))
+	}
+	return files, nil
+}
+
+// MetaPath returns the sidecar path for one fixture recording.
+func MetaPath(recording string) string {
+	return strings.TrimSuffix(recording, recordingExt) + metaSuffix
+}
+
+func stringOf(v *string) string {
+	if v == nil {
+		return ""
+	}
+	return *v
+}
diff --git a/internal/core/quality/score.go b/internal/core/quality/score.go
new file mode 100644
index 000000000..3cb5c9dcd
--- /dev/null
+++ b/internal/core/quality/score.go
@@ -0,0 +1,329 @@
+package quality
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+const statusPass = "PASS"
+
+// Matcher is the compiled, deterministic scorer. Every pattern is
+// case-insensitive and applied to lowercased path + "\n" + claim with no
+// whitespace folding, matching the harness the hand scores came from.
+type Matcher struct {
+	compiled   map[string]*regexp.Regexp
+	praise     *regexp.Regexp
+	defectVerb *regexp.Regexp
+}
+
+// NewMatcher compiles every pattern in the catalog once. Catalog validation
+// has already refused invalid patterns.
+func NewMatcher(c *Catalog) *Matcher {
+	m := &Matcher{compiled: map[string]*regexp.Regexp{}}
+	for i := range c.Fixtures {
+		compileDefects(m, c.Fixtures[i].Known)
+		compileDefects(m, c.Fixtures[i].Bonus)
+	}
+	m.praise = regexp.MustCompile("(?i)" + c.ReviewSignals.PraiseRE)
+	m.defectVerb = regexp.MustCompile("(?i)" + c.ReviewSignals.DefectVerbRE)
+	return m
+}
+
+func compileDefects(m *Matcher, defects []Defect) {
+	for i := range defects {
+		for _, rule := range defects[i].Matchers {
+			compileRule(m, rule)
+		}
+	}
+}
+
+func compileRule(m *Matcher, rule []string) {
+	for _, pattern := range rule {
+		if _, ok := m.compiled[pattern]; !ok {
+			m.compiled[pattern] = regexp.MustCompile("(?i)" + pattern)
+		}
+	}
+}
+
+// Matches applies one defect's rules to one finding: all patterns in a rule
+// must match, and any rule may match.
+func (m *Matcher) Matches(f *Finding, rules [][]string) bool {
+	text := strings.ToLower(f.Path + "\n" + f.Claim)
+	for _, rule := range rules {
+		if m.ruleMatches(rule, text) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Matcher) ruleMatches(rule []string, text string) bool {
+	for _, pattern := range rule {
+		if !m.compiled[pattern].MatchString(text) {
+			return false
+		}
+	}
+	return true
+}
+
+// Hit reports whether any finding satisfies a defect's rules. Findings are
+// not consumed: one finding may hit several related defects.
+func (m *Matcher) Hit(findings []Finding, d Defect) bool {
+	for i := range findings {
+		if m.Matches(&findings[i], d.Matchers) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Matcher) isPraise(f *Finding) bool {
+	text := strings.ToLower(f.Claim)
+	return m.praise.MatchString(text) && !m.defectVerb.MatchString(text)
+}
+
+// RunScore is one scored recording: per-defect hits plus the diagnostic
+// columns the calibration table prints.
+type RunScore struct {
+	Hits          map[string]bool
+	BonusHits     map[string]bool
+	GatePassed    *bool
+	Recording     string
+	Fixture       string
+	Driver        string
+	InfraError    string
+	RefusalCode   string
+	Praise        int
+	NullSeverity  int
+	OtherFindings int
+	Scored        bool
+}
+
+// Score grades one recording against one fixture's defects.
+func Score(m *Matcher, f *Fixture, findings []Finding, meta *RecordingMeta,
+	gate *bool, recording string,
+) *RunScore {
+	run := &RunScore{
+		Recording:   recording,
+		Fixture:     f.ID,
+		Driver:      meta.Driver,
+		Hits:        map[string]bool{},
+		BonusHits:   map[string]bool{},
+		GatePassed:  gate,
+		InfraError:  meta.InfraError,
+		RefusalCode: meta.RefusalCode,
+		Scored:      meta.InfraError == "",
+	}
+	if !run.Scored {
+		return run
+	}
+	matched := map[string][][]string{}
+	collectHits(m, f.Known, findings, run.Hits, matched)
+	collectHits(m, f.Bonus, findings, run.BonusHits, matched)
+	scoreDiagnostics(m, run, findings, matched)
+	return run
+}
+
+func collectHits(m *Matcher, defects []Defect, findings []Finding,
+	hits map[string]bool, matched map[string][][]string,
+) {
+	for i := range defects {
+		d := &defects[i]
+		hits[d.ID] = m.Hit(findings, *d)
+		if hits[d.ID] {
+			matched[d.ID] = d.Matchers
+		}
+	}
+}
+
+func scoreDiagnostics(m *Matcher, run *RunScore, findings []Finding, matched map[string][][]string) {
+	for i := range findings {
+		f := &findings[i]
+		if f.Severity == "" {
+			run.NullSeverity++
+		}
+		if m.isPraise(f) {
+			run.Praise++
+			continue
+		}
+		if !anyMatch(m, f, matched) {
+			run.OtherFindings++
+		}
+	}
+}
+
+func anyMatch(m *Matcher, f *Finding, matched map[string][][]string) bool {
+	for _, rules := range matched {
+		if m.Matches(f, rules) {
+			return true
+		}
+	}
+	return false
+}
+
+// RecallHits renders one run's exact hit count, as the harness table does.
+func RecallHits(run *RunScore, known int) string {
+	if !run.Scored {
+		return "n/a"
+	}
+	return strconv.Itoa(countTrue(run.Hits)) + "/" + strconv.Itoa(known)
+}
+
+func countTrue(m map[string]bool) int {
+	n := 0
+	for _, v := range m {
+		if v {
+			n++
+		}
+	}
+	return n
+}
+
+// CalibrationRowResult is one row of the hand-score table. Hand and harness
+// expectations are compared as hit-id sets, as the harness calibrate did.
+type CalibrationRowResult struct {
+	Recording    string
+	Fixture      string
+	Driver       string
+	Hand         string
+	Harness      string
+	HandHits     string
+	HarnessHits  string
+	Status       string
+	Reason       string
+	Praise       int
+	NullSeverity int
+}
+
+// CalibrationResult holds every row and the single reproduced verdict.
+type CalibrationResult struct {
+	Rows       []CalibrationRowResult
+	Reproduced bool
+}
+
+// Calibrate compares each recorded run with the hand score pinned in the
+// catalog. The hand scores are literals from the archived RUN.md; the scorer
+// never supplies its own expectation.
+func Calibrate(c *Catalog, runs []RunScore) *CalibrationResult {
+	byName := make(map[string]*RunScore, len(runs))
+	for i := range runs {
+		byName[runs[i].Recording] = &runs[i]
+	}
+	result := &CalibrationResult{Reproduced: true}
+	fixtures := map[string]*Fixture{}
+	for i := range c.Fixtures {
+		fixtures[c.Fixtures[i].ID] = &c.Fixtures[i]
+	}
+	for i := range c.Calibration {
+		row := calibrationRow(byName, fixtures, &c.Calibration[i])
+		result.Rows = append(result.Rows, *row)
+		if row.Status != statusPass {
+			result.Reproduced = false
+		}
+	}
+	return result
+}
+
+func calibrationRow(byName map[string]*RunScore, fixtures map[string]*Fixture,
+	row *CalibrationRow,
+) *CalibrationRowResult {
+	hand := set(row.Hand)
+	missing := &CalibrationRowResult{
+		Recording: row.Recording, Fixture: row.Fixture, Driver: row.Driver,
+		Hand: row.HandLabel, Harness: notApplicable, HandHits: orDash(joinSet(hand)),
+		HarnessHits: "-", Status: "FAIL",
+	}
+	run := byName[row.Recording]
+	fixture := fixtures[row.Fixture]
+	if run == nil || fixture == nil {
+		return missing
+	}
+	harness := hits(run.Hits)
+	status := "FAIL"
+	reason := ""
+	switch {
+	case !run.Scored:
+		reason = "unscored (infra error: " + run.InfraError + ")"
+	case run.Fixture != row.Fixture:
+		reason = "recording names fixture " + run.Fixture + ", calibration row names " + row.Fixture
+	case sameSet(hand, harness):
+		status = "PASS"
+	}
+	return &CalibrationRowResult{
+		Recording:    row.Recording,
+		Fixture:      row.Fixture,
+		Driver:       row.Driver,
+		Hand:         row.HandLabel,
+		Harness:      RecallHits(run, len(fixture.Known)),
+		HandHits:     orDash(joinSet(hand)),
+		HarnessHits:  orDash(joinSet(harness)),
+		Praise:       run.Praise,
+		NullSeverity: run.NullSeverity,
+		Status:       status,
+		Reason:       reason,
+	}
+}
+
+func set(ids []string) map[string]bool {
+	out := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		out[id] = true
+	}
+	return out
+}
+
+func hits(values map[string]bool) map[string]bool {
+	out := map[string]bool{}
+	for id, hit := range values {
+		if hit {
+			out[id] = true
+		}
+	}
+	return out
+}
+
+func sameSet(a, b map[string]bool) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for id := range a {
+		if !b[id] {
+			return false
+		}
+	}
+	return true
+}
+
+func joinSet(values map[string]bool) string {
+	ids := make([]string, 0, len(values))
+	for id := range values {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+	return strings.Join(ids, ",")
+}
+
+// CalibrationTable renders the seven-row table the harness published.
+func CalibrationTable(result *CalibrationResult) string {
+	var sb strings.Builder
+	sb.WriteString("| bundle | fixture | driver | hand | harness | hand hits | harness hits | praise | null sev | status | reason |\n")
+	sb.WriteString("| --- | --- | --- | --- | --- | --- | --- | ---: | ---: | --- | --- |\n")
+	for i := range result.Rows {
+		row := &result.Rows[i]
+		fmt.Fprintf(&sb, "| %s | %s | %s | %s | %s | %s | %s | %d | %d | %s | %s |\n",
+			row.Recording, row.Fixture, row.Driver, row.Hand, row.Harness,
+			orDash(row.HandHits), orDash(row.HarnessHits), row.Praise, row.NullSeverity,
+			row.Status, orDash(row.Reason))
+	}
+	return sb.String()
+}
+
+func orDash(s string) string {
+	if s == "" {
+		return "-"
+	}
+	return s
+}
