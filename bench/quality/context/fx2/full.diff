+package drain
+
+import (
+	"testing"
+
+	threadscore "github.com/stainless-code/verdict/internal/core/threads"
+)
+
+func planFeed() *threadscore.File {
+	return &threadscore.File{Threads: []threadscore.Thread{
+		thread("t1", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, false, false,
+			comment("r1", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w1", "alice", threadscore.AuthorHuman, "2026-11-02T00:00:00Z")),
+		thread("t2", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, false, false,
+			comment("r2", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w2", "dependabot[bot]", threadscore.AuthorBot, "2026-11-02T00:00:00Z")),
+		thread("t3", threadscore.KindReview, "alice", threadscore.AuthorHuman, false, false,
+			comment("r3", "alice", threadscore.AuthorHuman, "2026-11-02T00:00:00Z")),
+	}}
+}
+
+func TestNewPlanPinsDigestAndSkips(t *testing.T) {
+	t.Parallel()
+	feed := planFeed()
+	plan, deferred := NewPlan("github", 7, "head", "2026-11-03T00:00:00Z", "verdict-bot", feed, nil, 20)
+	if len(deferred) != 0 || len(plan.Pending) != 1 || plan.Pending[0].ThreadID != "t1" {
+		t.Fatalf("plan pending = %+v, deferred = %v", plan.Pending, deferred)
+	}
+	if len(plan.Skipped) != 1 || plan.Skipped[0] != (Skip{ThreadID: "t2", Reason: ReasonBotReply}) {
+		t.Errorf("plan skipped = %+v", plan.Skipped)
+	}
+	if plan.OtherThreads != 1 || plan.SchemaVersion != SchemaVersion || plan.Provider != "github" ||
+		plan.HeadSHA != "head" || plan.Self != "verdict-bot" {
+		t.Errorf("plan envelope fields drifted: %+v", plan)
+	}
+	if len(plan.PlanDigest) != 64 {
+		t.Fatalf("plan_digest = %q, want a 64-hex sha256", plan.PlanDigest)
+	}
+}
+
+func TestNewPlanDigestPinsWaitingComment(t *testing.T) {
+	t.Parallel()
+	feed := planFeed()
+	first, _ := NewPlan("github", 7, "head", "2026-11-03T00:00:00Z", "verdict-bot", feed, nil, 20)
+	feed.Threads[0].Comments[1].ID = "w9"
+	changed, _ := NewPlan("github", 7, "head", "2026-11-03T00:00:00Z", "verdict-bot", feed, nil, 20)
+	if changed.PlanDigest == first.PlanDigest {
+		t.Error("a new waiting comment kept the same plan_digest")
+	}
+}
diff --git a/internal/core/drain/select.go b/internal/core/drain/select.go
new file mode 100644
index 000000000..ed3556a91
--- /dev/null
+++ b/internal/core/drain/select.go
@@ -0,0 +1,209 @@
+// Package drain selects review threads that are waiting on a verdict reply.
+// Selection is pure: the feed, the authenticated login, and the reply ledger
+// are inputs, and the caller owns every write.
+package drain
+
+import (
+	"slices"
+	"strings"
+	"time"
+
+	fetchcore "github.com/stainless-code/verdict/internal/core/fetch"
+	threadscore "github.com/stainless-code/verdict/internal/core/threads"
+)
+
+const (
+	// ReasonResolved is a thread the host already closed.
+	ReasonResolved = "resolved"
+	// ReasonAnswered is a thread the recorded ledger already answers.
+	ReasonAnswered = "answered"
+	// ReasonBotReply is a thread whose last reply came from a bot.
+	ReasonBotReply = "bot-reply"
+	// ReasonAlreadyReplied is a thread verdict has already answered.
+	ReasonAlreadyReplied = "already-replied"
+	// ReasonNotReview is a self-authored thread that is not a review comment.
+	ReasonNotReview = "not-review-comment"
+	// ReasonDeferred is a pending thread past the operator's cap.
+	ReasonDeferred = "deferred"
+	// ReasonNoDraft is a pending thread the agent did not write a draft for.
+	ReasonNoDraft = "no-draft"
+	// ReplyBy is the author recorded on a drain ledger entry.
+	ReplyBy = "drain"
+	// DefaultMaxThreads is the cap used when the operator gives none.
+	DefaultMaxThreads = 20
+	// MaxMaxThreads is the largest cap the verb accepts.
+	MaxMaxThreads = 100
+)
+
+// LedgerEntry is one recorded reply. Older address-reviews entries carry only
+// thread, reply_id, and at: they answer every comment in the thread created at
+// or before at. Drain entries name the waiting comment in in_reply_to.
+type LedgerEntry struct {
+	Thread    string `json:"thread"`
+	ReplyID   string `json:"reply_id"`
+	At        string `json:"at"`
+	InReplyTo string `json:"in_reply_to,omitempty"`
+	By        string `json:"by,omitempty"`
+}
+
+// Pending is one thread whose last comment is a human question verdict has
+// not answered, joined to the finding the root comment carries.
+type Pending struct { //nolint:govet // field order is the published JSON contract
+	ThreadID         string  `json:"thread_id"`
+	RootCommentID    string  `json:"root_comment_id"`
+	WaitingCommentID string  `json:"waiting_comment_id"`
+	WaitingAuthor    string  `json:"waiting_author"`
+	WaitingAt        string  `json:"waiting_at"`
+	Path             string  `json:"path"`
+	Line             *int    `json:"line"`
+	Outdated         bool    `json:"outdated"`
+	FindingSig       *string `json:"finding_sig"`
+}
+
+// Skip is one verdict-authored thread the run did not draft, with the reason
+// an operator can check against the feed.
+type Skip struct {
+	ThreadID string `json:"thread_id"`
+	Reason   string `json:"reason"`
+}
+
+// Select applies the drain waiting rules to one refreshed feed. Pending is
+// oldest waiting comment first; beyond max, threads are deferred. Threads
+// verdict did not author are excluded from all three results.
+func Select(feed *threadscore.File, self string, ledger []LedgerEntry, limit int) ([]Pending, []Skip, []string) {
+	pending, skipped := classify(feed, self, ledger)
+	slices.SortFunc(pending, func(a, b Pending) int { return byWaitingAt(&a, &b) })
+	deferred := []string{}
+	if limit > 0 && len(pending) > limit {
+		for _, item := range pending[limit:] {
+			skipped = append(skipped, Skip{ThreadID: item.ThreadID, Reason: ReasonDeferred})
+			deferred = append(deferred, item.ThreadID)
+		}
+		pending = pending[:limit]
+	}
+	return pending, skipped, deferred
+}
+
+func classify(feed *threadscore.File, self string, ledger []LedgerEntry) ([]Pending, []Skip) {
+	if feed == nil {
+		return []Pending{}, []Skip{}
+	}
+	pending := make([]Pending, 0, len(feed.Threads))
+	skipped := make([]Skip, 0, len(feed.Threads))
+	for i := range feed.Threads {
+		thread := &feed.Threads[i]
+		if !fetchcore.SelfAuthored(thread, self) {
+			continue
+		}
+		reason := skipReason(thread, ledger)
+		if reason != "" {
+			skipped = append(skipped, Skip{ThreadID: thread.ID, Reason: reason})
+			continue
+		}
+		pending = append(pending, toPending(thread))
+	}
+	return pending, skipped
+}
+
+// OtherThreads counts threads verdict did not author. They are never listed
+// as skips: a reply to someone else's thread is not verdict's to make.
+func OtherThreads(feed *threadscore.File, self string) int {
+	if feed == nil {
+		return 0
+	}
+	n := 0
+	for i := range feed.Threads {
+		if !fetchcore.SelfAuthored(&feed.Threads[i], self) {
+			n++
+		}
+	}
+	return n
+}
+
+func skipReason(thread *threadscore.Thread, ledger []LedgerEntry) string {
+	if thread.Kind != threadscore.KindReview {
+		return ReasonNotReview
+	}
+	if thread.Resolved {
+		return ReasonResolved
+	}
+	last := lastComment(thread)
+	switch last.AuthorKind {
+	case threadscore.AuthorBot:
+		return ReasonBotReply
+	case threadscore.AuthorVerdict:
+		return ReasonAlreadyReplied
+	}
+	if answered(ledger, thread.ID, &last) {
+		return ReasonAnswered
+	}
+	return ""
+}
+
+func lastComment(thread *threadscore.Thread) threadscore.Comment {
+	if len(thread.Comments) == 0 {
+		return threadscore.Comment{Author: thread.Author, AuthorKind: thread.AuthorKind}
+	}
+	return thread.Comments[len(thread.Comments)-1]
+}
+
+func answered(ledger []LedgerEntry, threadID string, last *threadscore.Comment) bool {
+	for i := range ledger {
+		entry := &ledger[i]
+		if entry.Thread == threadID && entry.ReplyID != "" && entryAnswers(entry, last) {
+			return true
+		}
+	}
+	return false
+}
+
+func entryAnswers(entry *LedgerEntry, last *threadscore.Comment) bool {
+	if entry.InReplyTo != "" {
+		return entry.InReplyTo == last.ID
+	}
+	return notAfter(last.CreatedAt, entry.At)
+}
+
+func notAfter(when, at string) bool {
+	left, lerr := time.Parse(time.RFC3339, when)
+	right, rerr := time.Parse(time.RFC3339, at)
+	if lerr != nil || rerr != nil {
+		return strings.TrimSpace(when) != "" && strings.Compare(when, at) <= 0
+	}
+	return !left.After(right)
+}
+
+func toPending(thread *threadscore.Thread) Pending {
+	last := lastComment(thread)
+	root := ""
+	if len(thread.Comments) > 0 {
+		root = thread.Comments[0].ID
+	}
+	return Pending{
+		ThreadID:         thread.ID,
+		RootCommentID:    root,
+		WaitingCommentID: last.ID,
+		WaitingAuthor:    last.Author,
+		WaitingAt:        last.CreatedAt,
+		Path:             thread.Path,
+		Line:             thread.Line,
+		Outdated:         thread.Outdated,
+		FindingSig:       thread.FindingSig,
+	}
+}
+
+func byWaitingAt(a, b *Pending) int {
+	left, leftErr := time.Parse(time.RFC3339, a.WaitingAt)
+	right, rightErr := time.Parse(time.RFC3339, b.WaitingAt)
+	if leftErr == nil && rightErr == nil {
+		if left.Before(right) {
+			return -1
+		}
+		if left.After(right) {
+			return 1
+		}
+	} else if c := strings.Compare(a.WaitingAt, b.WaitingAt); c != 0 {
+		return c
+	}
+	return strings.Compare(a.ThreadID, b.ThreadID)
+}
diff --git a/internal/core/drain/select_test.go b/internal/core/drain/select_test.go
new file mode 100644
index 000000000..dab0b36a1
--- /dev/null
+++ b/internal/core/drain/select_test.go
@@ -0,0 +1,175 @@
+package drain
+
+import (
+	"reflect"
+	"testing"
+
+	threadscore "github.com/stainless-code/verdict/internal/core/threads"
+)
+
+func thread(id, kind, author, authorKind string, resolved, outdated bool, comments ...threadscore.Comment) threadscore.Thread {
+	line := 10
+	finding := "abc"
+	return threadscore.Thread{
+		ID: id, Kind: kind, Author: author, AuthorKind: authorKind,
+		Resolved: resolved, Outdated: outdated, Path: "a.go", Line: &line,
+		FindingSig: &finding, Comments: comments,
+	}
+}
+
+func comment(id, author, authorKind, at string) threadscore.Comment {
+	return threadscore.Comment{ID: id, Author: author, AuthorKind: authorKind, CreatedAt: at}
+}
+
+func waitingFeed() *threadscore.File {
+	feed := &threadscore.File{Threads: []threadscore.Thread{
+		thread("review", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, false, true,
+			comment("r1", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w1", "alice", threadscore.AuthorHuman, "2026-11-02T00:00:00Z")),
+		thread("resolved", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, true, false,
+			comment("r2", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w2", "alice", threadscore.AuthorHuman, "2026-11-02T00:00:00Z")),
+		thread("bot", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, false, false,
+			comment("r3", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w3", "dependabot[bot]", threadscore.AuthorBot, "2026-11-02T00:00:00Z")),
+		thread("answered", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, false, false,
+			comment("r4", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w4", "alice", threadscore.AuthorHuman, "2026-11-02T00:00:00Z")),
+		thread("verdict-last", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, false, false,
+			comment("r5", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w5", "alice", threadscore.AuthorHuman, "2026-11-02T00:00:00Z"),
+			comment("v5", "verdict-bot", threadscore.AuthorVerdict, "2026-11-03T00:00:00Z")),
+		thread("issue", threadscore.KindIssue, "verdict-bot", threadscore.AuthorVerdict, false, false,
+			comment("r6", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w6", "alice", threadscore.AuthorHuman, "2026-11-02T00:00:00Z")),
+		thread("human", threadscore.KindReview, "alice", threadscore.AuthorHuman, false, false,
+			comment("r7", "alice", threadscore.AuthorHuman, "2026-11-01T00:00:00Z"),
+			comment("w7", "bob", threadscore.AuthorHuman, "2026-11-02T00:00:00Z")),
+		thread("solo", threadscore.KindReview, "verdict-bot", threadscore.AuthorVerdict, false, false,
+			comment("r8", "verdict-bot", threadscore.AuthorVerdict, "2026-11-01T00:00:00Z"),
+			comment("w8", "operator", threadscore.AuthorHuman, "2026-11-04T00:00:00Z")),
+	}}
+	return feed
+}
+
+func TestSelectWaitingRules(t *testing.T) {
+	t.Parallel()
+	feed := waitingFeed()
+	ledger := []LedgerEntry{
+		{Thread: "answered", ReplyID: "9", InReplyTo: "w4", At: "2026-11-03T00:00:00Z", By: ReplyBy},
+	}
+	pending, skipped, deferred := Select(feed, "verdict-bot", ledger, 20)
+	assertWaitingSelection(t, pending, skipped, deferred)
+	if got := OtherThreads(feed, "verdict-bot"); got != 1 {
+		t.Errorf("other_threads = %d, want 1", got)
+	}
+}
+
+func assertWaitingSelection(t *testing.T, pending []Pending, skipped []Skip, deferred []string) {
+	t.Helper()
+	wantPending := []string{"review", "solo"}
+	if got := ids(pending); !reflect.DeepEqual(got, wantPending) {
+		t.Errorf("pending = %v, want %v", got, wantPending)
+	}
+	wantSkipped := []Skip{
+		{ThreadID: "resolved", Reason: ReasonResolved},
+		{ThreadID: "bot", Reason: ReasonBotReply},
+		{ThreadID: "answered", Reason: ReasonAnswered},
+		{ThreadID: "verdict-last", Reason: ReasonAlreadyReplied},
+		{ThreadID: "issue", Reason: ReasonNotReview},
+	}
+	if !reflect.DeepEqual(skipped, wantSkipped) {
+		t.Errorf("skipped = %v, want %v", skipped, wantSkipped)
+	}
+	if len(deferred) != 0 {
+		t.Errorf("deferred = %v, want none", deferred)
+	}
+	assertPendingJoin(t, &pending[0])
+}
+
+func assertPendingJoin(t *testing.T, p *Pending) {
+	t.Helper()
+	if p.RootCommentID != "r1" || p.WaitingCommentID != "w1" || p.WaitingAuthor != "alice" {
