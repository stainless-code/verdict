diff --git a/internal/core/drain/drafts.go b/internal/core/drain/drafts.go
new file mode 100644
index 000000000..d54900799
--- /dev/null
+++ b/internal/core/drain/drafts.go
@@ -0,0 +1,218 @@
+package drain
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/stainless-code/verdict/internal/core"
+	"github.com/stainless-code/verdict/internal/jq"
+)
+
+// Disposition is one action the agent may take for a pending thread.
+type Disposition string
+
+const (
+	// DispositionAnswer posts the draft body.
+	DispositionAnswer Disposition = "answer"
+	// DispositionWithdraw posts the body and resolves the finding.
+	DispositionWithdraw Disposition = "withdraw"
+	// DispositionDefer records a decision that still belongs to a human.
+	DispositionDefer Disposition = "defer"
+	// MaxBodyRunes caps one reply body. The limit is characters, not bytes,
+	// so a multi-byte language does not lose half a sentence.
+	MaxBodyRunes = 4000
+	markerPrefix = "<!-- verdict-"
+	keyReplies   = "replies"
+)
+
+// Reply is one draft answer to a waiting comment.
+type Reply struct {
+	ThreadID         string      `json:"thread_id"`
+	WaitingCommentID string      `json:"waiting_comment_id"`
+	Disposition      Disposition `enum:"answer|withdraw|defer" json:"disposition"`
+	Body             string      `json:"body"                  maxLength:"4000"`
+}
+
+// RepliesFile is the single artifact the drafting agent writes.
+type RepliesFile struct {
+	SchemaVersion string  `const:"1"          json:"schema_version"`
+	PlanDigest    string  `json:"plan_digest"`
+	Replies       []Reply `json:"replies"`
+}
+
+// CheckDrafts validates one raw drafts document against a plan without any
+// I/O. The site in each refusal names the exact field an agent must fix.
+func CheckDrafts(raw []byte, plan *File) (*Drafts, []Skip, *core.RefusalError) {
+	if plan == nil {
+		return nil, nil, invalid("plan", "no plan to draft against")
+	}
+	doc, root, ref := parseDrafts(raw, plan)
+	if ref != nil {
+		return nil, nil, ref
+	}
+	pending := make(map[string]Pending, len(plan.Pending))
+	for _, p := range plan.Pending {
+		pending[p.ThreadID] = p
+	}
+	summary := &Drafts{File: KeyDraftsJSON}
+	seen, ref := checkReplies(doc.Replies, root[keyReplies], pending, summary)
+	if ref != nil {
+		return nil, nil, ref
+	}
+	summary.Count = len(doc.Replies)
+	return summary, noDrafts(plan.Pending, seen), nil
+}
+
+func checkReplies(replies []Reply, raw json.RawMessage, pending map[string]Pending, summary *Drafts) (map[string]bool, *core.RefusalError) {
+	seen := make(map[string]bool, len(replies))
+	for i, reply := range replies {
+		site := fmt.Sprintf("replies[%d]", i)
+		if ref := validateFields(raw, i, site); ref != nil {
+			return nil, ref
+		}
+		if ref := checkReply(reply, pending, seen, site, summary); ref != nil {
+			return nil, ref
+		}
+	}
+	return seen, nil
+}
+
+func noDrafts(pending []Pending, seen map[string]bool) []Skip {
+	skipped := []Skip{}
+	for _, p := range pending {
+		if !seen[p.ThreadID] {
+			skipped = append(skipped, Skip{ThreadID: p.ThreadID, Reason: ReasonNoDraft})
+		}
+	}
+	return skipped
+}
+
+func parseDrafts(raw []byte, plan *File) (*RepliesFile, map[string]json.RawMessage, *core.RefusalError) {
+	var root map[string]json.RawMessage
+	if err := decodeStrict(raw, &root); err != nil {
+		return nil, nil, invalid("root", err.Error())
+	}
+	if ref := checkRootKeys(root); ref != nil {
+		return nil, nil, ref
+	}
+	replies, ref := parseReplies(root)
+	if ref != nil {
+		return nil, nil, ref
+	}
+	var doc RepliesFile
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return nil, nil, invalid("root", err.Error())
+	}
+	doc.Replies = replies
+	if doc.SchemaVersion != SchemaVersion {
+		return nil, nil, invalid("schema_version", fmt.Sprintf("got %q, want %q", doc.SchemaVersion, SchemaVersion))
+	}
+	if doc.PlanDigest != plan.PlanDigest {
+		return nil, nil, &core.RefusalError{Code: "drafts-stale", Message: fmt.Sprintf(
+			"drain.replies.json plan_digest %q does not match the plan's %q; re-run drain for a fresh plan",
+			doc.PlanDigest, plan.PlanDigest)}
+	}
+	return &doc, root, nil
+}
+
+func checkRootKeys(root map[string]json.RawMessage) *core.RefusalError {
+	for key := range root {
+		if !slices.Contains([]string{"schema_version", "plan_digest", keyReplies}, key) {
+			return invalid("root."+key, "unknown key")
+		}
+	}
+	return nil
+}
+
+func parseReplies(root map[string]json.RawMessage) ([]Reply, *core.RefusalError) {
+	raw, ok := root[keyReplies]
+	if !ok || bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+		return nil, invalid(keyReplies, "must be an array")
+	}
+	var replies []Reply
+	if err := json.Unmarshal(raw, &replies); err != nil {
+		return nil, invalid(keyReplies, err.Error())
+	}
+	return replies, nil
+}
+
+func checkReply(reply Reply, pending map[string]Pending, seen map[string]bool, site string, summary *Drafts) *core.RefusalError {
+	if seen[reply.ThreadID] {
+		return invalid(site+".thread_id", "duplicate thread "+reply.ThreadID)
+	}
+	seen[reply.ThreadID] = true
+	p, ok := pending[reply.ThreadID]
+	if !ok {
+		return invalid(site+".thread_id", "thread "+reply.ThreadID+" is not pending in the plan")
+	}
+	if reply.WaitingCommentID != p.WaitingCommentID {
+		return invalid(site+".waiting_comment_id", "got "+reply.WaitingCommentID+", want "+p.WaitingCommentID)
+	}
+	if ref := checkBody(reply, site); ref != nil {
+		return ref
+	}
+	return countDisposition(reply.Disposition, summary, site)
+}
+
+func checkBody(reply Reply, site string) *core.RefusalError {
+	if strings.Contains(reply.Body, markerPrefix) {
+		return invalid(site+".body", "a draft must not carry verdict's marker")
+	}
+	if n := utf8.RuneCountInString(reply.Body); n > MaxBodyRunes {
+		return invalid(site+".body", fmt.Sprintf("body is %d characters, max %d", n, MaxBodyRunes))
+	}
+	if reply.Disposition != DispositionDefer && strings.TrimSpace(reply.Body) == "" {
+		return invalid(site+".body", "answer and withdraw need a non-empty body")
+	}
+	return nil
+}
+
+func countDisposition(d Disposition, summary *Drafts, site string) *core.RefusalError {
+	switch d {
+	case DispositionAnswer:
+		summary.Dispositions.Answer++
+	case DispositionWithdraw:
+		summary.Dispositions.Withdraw++
+	case DispositionDefer:
+		summary.Dispositions.Defer++
+	default:
+		return invalid(site+".disposition", fmt.Sprintf("unknown disposition %q", d))
+	}
+	return nil
+}
+
+func validateFields(raw json.RawMessage, index int, site string) *core.RefusalError {
+	var replies []map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &replies); err != nil {
+		return invalid(site, err.Error())
+	}
+	if index >= len(replies) {
+		return invalid(site, "missing entry")
+	}
+	for key := range replies[index] {
+		if !slices.Contains([]string{"thread_id", "waiting_comment_id", "disposition", "body"}, key) {
+			return invalid(site+"."+key, "unknown key")
+		}
+	}
+	return nil
+}
+
+func decodeStrict(raw []byte, into any) error {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(into); err != nil {
+		return jq.NewErrf("decode JSON: %v", err)
+	}
+	if dec.More() {
+		return jq.NewErr("more than one JSON value")
+	}
+	return nil
+}
+
+func invalid(site, reason string) *core.RefusalError {
+	return &core.RefusalError{Code: "drafts-invalid", Message: "drain.replies.json " + site + ": " + reason}
+}
diff --git a/internal/core/drain/drafts_test.go b/internal/core/drain/drafts_test.go
new file mode 100644
index 000000000..0c3c5727b
--- /dev/null
+++ b/internal/core/drain/drafts_test.go
@@ -0,0 +1,125 @@
+package drain
+
+import (
+	"strings"
+	"testing"
+)
+
+func draftPlan() *File {
+	return &File{
+		SchemaVersion: SchemaVersion, PlanDigest: Digest([]Pending{{
+			ThreadID: "t1", WaitingCommentID: "w1",
+		}}),
+		Pending: []Pending{{ThreadID: "t1", WaitingCommentID: "w1"}},
+	}
+}
+
+func validDraft() string {
+	return draftEnvelope(`,"replies":[{"thread_id":"t1","waiting_comment_id":"w1","disposition":"answer","body":"a real answer"}]`)
+}
+
+func draftEnvelope(replies string) string {
+	return `{"schema_version":"1","plan_digest":"` + draftPlan().PlanDigest + `"` + replies + `}`
+}
+
+func replace(raw, from, to string) string {
+	if !strings.Contains(raw, from) {
+		return raw + "/* missing target */"
+	}
+	return strings.Replace(raw, from, to, 1)
+}
+
+const bodyField = `"body":"a real answer"`
+
+func TestCheckDraftsSites(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name, site, code, raw string
+	}{
+		{
+			name: "missing replies", site: "replies", code: "drafts-invalid",
+			raw: draftEnvelope(""),
+		},
+		{
+			name: "null replies", site: "replies", code: "drafts-invalid",
+			raw: draftEnvelope(`,"replies":null`),
+		},
+		{
+			name: "unknown root key", site: "root.extra", code: "drafts-invalid",
+			raw: replace(validDraft(), `{"schema_version"`, `{"extra":true,"schema_version"`),
+		},
+		{
+			name: "unknown entry key", site: "replies[0].extra", code: "drafts-invalid",
+			raw: replace(validDraft(), bodyField, bodyField+`,"extra":true`),
+		},
+		{
+			name: "unknown thread", site: "replies[0].thread_id", code: "drafts-invalid",
+			raw: replace(validDraft(), `"thread_id":"t1"`, `"thread_id":"t9"`),
+		},
+		{
+			name: "unknown comment", site: "replies[0].waiting_comment_id", code: "drafts-invalid",
+			raw: replace(validDraft(), `"waiting_comment_id":"w1"`, `"waiting_comment_id":"w9"`),
+		},
+		{
+			name: "bad disposition", site: "replies[0].disposition", code: "drafts-invalid",
+			raw: replace(validDraft(), `"disposition":"answer"`, `"disposition":"solve"`),
+		},
+		{
+			name: "empty body", site: "replies[0].body", code: "drafts-invalid",
+			raw: replace(validDraft(), bodyField, `"body":""`),
+		},
+		{
+			name: "over-cap body", site: "replies[0].body", code: "drafts-invalid",
+			raw: replace(validDraft(), `a real answer`, strings.Repeat("é", MaxBodyRunes+1)),
+		},
+		{
+			name: "over-cap defer body", site: "replies[0].body", code: "drafts-invalid",
+			raw: replace(replace(validDraft(), `"disposition":"answer"`, `"disposition":"defer"`), `a real answer`, strings.Repeat("x", MaxBodyRunes+1)),
+		},
+		{
+			name: "whitespace body", site: "replies[0].body", code: "drafts-invalid",
+			raw: replace(validDraft(), `a real answer`, ` \t\n`),
+		},
+		{
+			name: "marker body", site: "replies[0].body", code: "drafts-invalid",
+			raw: replace(validDraft(), `a real answer`, `answer <!-- verdict-finding sig=abc -->`),
+		},
+		{
+			name: "stale digest", site: "", code: "drafts-stale",
+			raw: replace(validDraft(), draftPlan().PlanDigest, "stale"),
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			_, _, ref := CheckDrafts([]byte(tc.raw), draftPlan())
+			if ref == nil || ref.Code != tc.code || !strings.Contains(ref.Message, tc.site) {
+				t.Errorf("refusal = %+v, want %s naming %q", ref, tc.code, tc.site)
+			}
+		})
+	}
+}
+
+func TestCheckDraftsGoodAndMissing(t *testing.T) {
+	t.Parallel()
+	deferRaw := replace(replace(validDraft(), `"disposition":"answer"`, `"disposition":"defer"`), bodyField, `"body":""`)
+	summary, skipped, ref := CheckDrafts([]byte(deferRaw), draftPlan())
+	if ref != nil || summary == nil || summary.Count != 1 || summary.Dispositions.Defer != 1 || len(skipped) != 0 {
+		t.Errorf("good draft = %+v, skipped %+v, refusal %+v", summary, skipped, ref)
+	}
+	noReplies := `{"schema_version":"1","plan_digest":"` + draftPlan().PlanDigest + `","replies":[]}`
+	summary, skipped, ref = CheckDrafts([]byte(noReplies), draftPlan())
+	if ref != nil || summary == nil || summary.Count != 0 || len(skipped) != 1 || skipped[0].Reason != ReasonNoDraft {
+		t.Errorf("missing draft = %+v, skipped %+v, refusal %+v", summary, skipped, ref)
+	}
+}
+
+func TestCheckDraftsDuplicateThread(t *testing.T) {
+	t.Parallel()
+	one := `{"thread_id":"t1","waiting_comment_id":"w1","disposition":"answer","body":"a real answer"}`
+	dup := `{"schema_version":"1","plan_digest":"` + draftPlan().PlanDigest + `","replies":[` + one + `,` + one + `]}`
+	_, _, ref := CheckDrafts([]byte(dup), draftPlan())
+	if ref == nil || ref.Code != "drafts-invalid" || !strings.Contains(ref.Message, "replies[1].thread_id") {
+		t.Errorf("duplicate refusal = %+v", ref)
+	}
+}
diff --git a/internal/core/drain/plan.go b/internal/core/drain/plan.go
new file mode 100644
index 000000000..67be9eb2c
--- /dev/null
+++ b/internal/core/drain/plan.go
@@ -0,0 +1,175 @@
+package drain
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"strings"
+
+	"github.com/stainless-code/verdict/internal/atomic"
+	threadscore "github.com/stainless-code/verdict/internal/core/threads"
+	"github.com/stainless-code/verdict/internal/jq"
+)
+
+const (
+	// SchemaVersion is the only drain JSON version published.
+	SchemaVersion = "1"
+	// KeyPlanJSON is the plan and receipt written into the bundle.
+	KeyPlanJSON = "drain.json"
+	// KeyDraftsJSON is the single artifact the drafting agent writes.
+	KeyDraftsJSON = "drain.replies.json"
+	// KeyLedgerJSON is the older replies ledger drain joins.
+	KeyLedgerJSON = "replies.json"
+	// CodeDrainFailed refuses a plan that cannot be built.
+	CodeDrainFailed = "drain-failed"
+	// CodeDraftsInvalid refuses a draft with a named bad site.
+	CodeDraftsInvalid = "drafts-invalid"
+	// CodeDraftsStale refuses a draft written against another plan.
+	CodeDraftsStale = "drafts-stale"
+	keyThreadID     = "thread_id"
+)
+
+// Dispositions counts the draft verdicts the agent chose.
+type Dispositions struct {
+	Answer   int `json:"answer"`
+	Withdraw int `json:"withdraw"`
+	Defer    int `json:"defer"`
+}
+
+// Drafts is the validated draft summary recorded in the plan.
+type Drafts struct {
+	File         string       `json:"file"`
+	Count        int          `json:"count"`
+	Dispositions Dispositions `json:"dispositions"`
+}
+
+// Posted is one successful host write (PR B records these).
+type Posted struct {
+	ThreadID    string `json:"thread_id"`
+	ReplyID     string `json:"reply_id"`
+	Disposition string `json:"disposition"`
+	Resolved    bool   `json:"resolved"`
+}
+
+// Failed is one host write that did not land (PR B records these).
+type Failed struct {
+	ThreadID string `json:"thread_id"`
+	Reason   string `json:"reason"`
+}
+
+// File is one drain plan and, after posting, its receipt.
+type File struct { //nolint:govet // field order is the published JSON contract
+	SchemaVersion string    `const:"1"                                            json:"schema_version"`
+	Provider      string    `enum:"github|gitlab|gitcafe|forgejo|bitbucket|azure" json:"provider"`
+	PR            int       `json:"pr"`
+	HeadSHA       string    `json:"head_sha"`
+	PlannedAt     string    `format:"date-time"                                   json:"planned_at"`
+	Self          string    `json:"self"`
+	PlanDigest    string    `json:"plan_digest"`
+	Pending       []Pending `json:"pending"`
+	Skipped       []Skip    `json:"skipped"`
+	OtherThreads  int       `json:"other_threads"`
+	Drafts        *Drafts   `anyOf:"null"                                         json:"drafts"`
+	Posted        []Posted  `json:"posted"`
+	Failed        []Failed  `json:"failed"`
+	PostedAt      *string   `format:"date-time"                                   json:"posted_at"`
+}
+
+// Wire renders the plan in published key order, with empty lists as [].
+func (f *File) Wire() *jq.Obj {
+	pending := make([]any, 0, len(f.Pending))
+	for i := range f.Pending {
+		pending = append(pending, toObj(&f.Pending[i]))
+	}
+	skipped := make([]any, 0, len(f.Skipped))
+	for _, s := range f.Skipped {
+		skipped = append(skipped, jq.NewObj(keyThreadID, s.ThreadID, "reason", s.Reason))
+	}
+	posted := make([]any, 0, len(f.Posted))
+	for _, p := range f.Posted {
+		posted = append(posted, jq.NewObj(keyThreadID, p.ThreadID, "reply_id", p.ReplyID,
+			"disposition", p.Disposition, "resolved", p.Resolved))
+	}
+	failed := make([]any, 0, len(f.Failed))
+	for _, x := range f.Failed {
+		failed = append(failed, jq.NewObj(keyThreadID, x.ThreadID, "reason", x.Reason))
+	}
+	var drafts any
+	if f.Drafts != nil {
+		drafts = jq.NewObj("file", f.Drafts.File, "count", f.Drafts.Count, "dispositions",
+			jq.NewObj("answer", f.Drafts.Dispositions.Answer, "withdraw", f.Drafts.Dispositions.Withdraw,
+				"defer", f.Drafts.Dispositions.Defer))
+	}
+	var postedAt any
+	if f.PostedAt != nil {
+		postedAt = *f.PostedAt
+	}
+	return jq.NewObj(
+		"schema_version", f.SchemaVersion,
+		"provider", f.Provider,
+		"pr", f.PR,
+		"head_sha", f.HeadSHA,
+		"planned_at", f.PlannedAt,
+		"self", f.Self,
+		"plan_digest", f.PlanDigest,
+		"pending", pending,
+		"skipped", skipped,
+		"other_threads", f.OtherThreads,
+		"drafts", drafts,
+		"posted", posted,
+		"failed", failed,
+		"posted_at", postedAt,
+	)
+}
+
+func toObj(p *Pending) *jq.Obj {
+	var line, finding any
+	if p.Line != nil {
+		line = *p.Line
+	}
+	if p.FindingSig != nil {
+		finding = *p.FindingSig
+	}
+	return jq.NewObj(
+		keyThreadID, p.ThreadID,
+		"root_comment_id", p.RootCommentID,
+		"waiting_comment_id", p.WaitingCommentID,
+		"waiting_author", p.WaitingAuthor,
+		"waiting_at", p.WaitingAt,
+		"path", p.Path,
+		"line", line,
+		"outdated", p.Outdated,
+		"finding_sig", finding,
+	)
+}
+
+// NewPlan selects the work for one run and pins it with a digest.
+func NewPlan(provider string, pr int, head, at, self string, feed *threadscore.File, ledger []LedgerEntry, limit int) (*File, []string) {
+	pending, skipped, deferred := Select(feed, self, ledger, limit)
+	return &File{
+		SchemaVersion: SchemaVersion, Provider: provider, PR: pr, HeadSHA: head,
+		PlannedAt: at, Self: self, PlanDigest: Digest(pending),
+		Pending: pending, Skipped: skipped, OtherThreads: OtherThreads(feed, self),
+		Posted: []Posted{}, Failed: []Failed{},
+	}, deferred
+}
+
+// Digest pins the canonical pending list: one thread id and waiting comment
+// id per line, in plan order. A draft written against a different selection
+// cannot match it.
+func Digest(pending []Pending) string {
+	var sb strings.Builder
+	for _, p := range pending {
+		fmt.Fprintf(&sb, "%s\n%s\n", p.ThreadID, p.WaitingCommentID)
+	}
+	sum := sha256.Sum256([]byte(sb.String()))
+	return hex.EncodeToString(sum[:])
+}
+
+// WritePlan writes one plan atomically.
+func WritePlan(path string, f *File) error {
+	if f.SchemaVersion == "" {
+		f.SchemaVersion = SchemaVersion
+	}
+	return atomic.WriteFile(path, []byte(jq.PrettyOrdered(f.Wire())))
+}
